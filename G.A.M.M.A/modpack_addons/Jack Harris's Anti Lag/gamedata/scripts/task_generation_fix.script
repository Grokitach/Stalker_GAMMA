-- Credit to Havron for original idea and fix
-- https://github.com/EduardHavron/GAMMA-fixes

-- We monkeypatch xr_conditions to scan 65k ID and cache in anomaly fields IDs
-- Cache is created on first refresh, and cleared up on moving to another map

local cached_anomalies = nil
local memo_prereqs = {}

local function get_anomaly_list()
	if cached_anomalies then
		return cached_anomalies
	end

	local lookup_map = {}
	local sim = alife()
	local gg = game_graph()
	if not sim or not gg then return {} end

	local l_insert = table.insert
	local def_level = level.name()
	local native_anomaly = IsAnomaly

	for id = 1, 65534 do
		local se_obj = sim:object(id)
		if se_obj then
			local is_anomaly = false
			if native_anomaly then
				is_anomaly = native_anomaly(se_obj)
			else
				local cls = se_obj:clsid()
				if cls and (cls == clsid.zone_bfuzz_s or cls == clsid.zone_galant_s or cls == clsid.zone_mbald_s) then
					is_anomaly = true
				end
			end

			if is_anomaly then
				local m_vertex = se_obj.m_game_vertex_id
				local lvl_id = m_vertex and gg:vertex(m_vertex):level_id()
				l_insert(lookup_map, {
					id = id,
					sec = se_obj:section_name(),
					lvl = lvl_id and sim:level_name(lvl_id) or def_level,
					online = se_obj.online
				})
			end
		end
	end

	cached_anomalies = lookup_map
	return lookup_map
end

local function flush_perf_cache()
	cached_anomalies = nil
	memo_prereqs = {}
end

local function init_prereq_optimization()
	local orig_prereq = xr_conditions and xr_conditions.has_completed_task_prerequisites
	if type(orig_prereq) ~= "function" then return end

	xr_conditions.has_completed_task_prerequisites = function(actor, npc, p, ...)
		if not db.actor then
			return orig_prereq(actor, npc, p, ...)
		end

		local task_id = p and p
		if type(task_id) ~= "string" then
			return orig_prereq(actor, npc, p, ...)
		end

		local now = time_global()
		local cached = memo_prereqs[task_id]
		if cached and (now - cached.time < 5000) then
			return cached.result
		end

		local res = orig_prereq(actor, npc, p, ...)
		memo_prereqs[task_id] = { time = now, result = res }
		return res
	end
end

local function init_measure_optimization()
	if type(xr_conditions.validate_measure_task) ~= "function" then return end

	xr_conditions.validate_measure_task = function(actor, npc, p)
		if not (p and type(p) == "table" and #p >= 5) then return false end

		local task_id = p
		local task_giver = (db.actor and db.actor:is_talking() and mob_trade.GetTalkingNpc()) or npc
		if not task_giver then return false end
		local task_giver_id = task_giver:id()

		local internal_cache = tasks_measure and tasks_measure.cache
		if internal_cache and internal_cache[task_id] and internal_cache[task_id][task_giver_id] then
			return true
		end

		local scan_mode = tonumber(p) or 4
		local monster_allow = (p == "true")
		local section_to_check = p

		if type(section_to_check) ~= "string" or section_to_check == "" or not ini_sys:section_exist(section_to_check) then
			return false
		end

		local requested_types = {}
		for i = 5, #p do
			if p[i] then requested_types[p[i]] = true end
		end

		local blacklisted = tasks_measure and tasks_measure.blacklisted_maps or {}
		local near_maps = simulation_objects.config:r_value(level.name(), "target_maps", 0, "") or ""
		local dyn_anomalies = bind_anomaly_field and bind_anomaly_field.dyn_anomalies or {}

		local targets = {}
		local anomalies = get_anomaly_list()
		local l_insert = table.insert
		local s_find = string.find

		for i = 1, #anomalies do
			local a = anomalies[i]
			local matched = false

			if requested_types["gravitational"] and (s_find(a.sec, "mbald") or s_find(a.sec, "mincer") or s_find(a.sec, "gravi")) then
				matched = true
			elseif requested_types["thermal"] and s_find(a.sec, "thermal") then
				matched = true
			elseif requested_types["chemical"] and s_find(a.sec, "chemical") then
				matched = true
			elseif requested_types["acidic"] and s_find(a.sec, "acid") then
				matched = true
			elseif requested_types["electric"] and s_find(a.sec, "electr") then
				matched = true
			end

			if matched and not blacklisted[a.lvl] and not (dyn_anomalies[a.lvl] and dyn_anomalies[a.lvl][a.id] ~= nil) then
				local is_online = a.online
				local is_nearby = s_find(near_maps, a.lvl) ~= nil

				if ((scan_mode == 1) and is_online)
				or ((scan_mode == 2) and (is_online or is_nearby))
				or ((scan_mode == 3) and is_nearby)
				or ((scan_mode == 4) and (not (is_online or is_nearby)))
				or (scan_mode == 5) then
					l_insert(targets, a.id)
				end
			end
		end

		if #targets == 0 then return false end

		local target_id = targets[math.random(#targets)]
		if not alife_object(target_id) then return false end

		if internal_cache then
			if not internal_cache[task_id] then internal_cache[task_id] = {} end
			internal_cache[task_id][task_giver_id] = {
				target_id = target_id,
				task_giver_comm = character_community(task_giver),
				item_1_sec = section_to_check,
				monster = monster_allow
			}
		end

		return true
	end
end

function on_game_start()
	init_prereq_optimization()
	init_measure_optimization()
	RegisterScriptCallback("on_level_changing", flush_perf_cache)
end
