local tg = 0
local hit_time = 0

local hit_interval = 9000 -- Every interval apply hit, in ms
local hit_type = hit.chemical_burn --hit.burn, change if needed

local valid_fields = { -- Valid fields to trigger hit
	zone_field_acidic_weak = true,
	zone_field_acidic_average = true,
	zone_field_acidic_strong = true,
}

-- Damage values of the hit
local damage_values = {
	zone_field_acidic_weak = 0.024,
	zone_field_acidic_average = 0.027,
	zone_field_acidic_strong = 0.04,
}

local function hit_callback(s_hit, bone_id, flags)
	tg = time_global()
	if tg < hit_time then return end
	hit_time = tg + hit_interval

	local field = s_hit.draftsman

	if not (field and field.section) then return end

	local section_name = field:section()
	if not valid_fields[section_name] then
		return
	end

	-- Old hit
	local field_hit = hit(s_hit)
	field_hit.power = damage_values[section_name]
	field_hit.type = hit_type

	db.actor:hit(field_hit)
end

function on_game_start()
	RegisterScriptCallback("actor_on_before_hit", hit_callback)
end