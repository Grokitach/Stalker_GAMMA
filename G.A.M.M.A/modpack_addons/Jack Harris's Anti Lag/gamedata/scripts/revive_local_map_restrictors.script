local function restore_map_activators()
	local current_level = level.name()
	local target_names = transition_registry[current_level]
	if not target_names then
		return
	end

	local alife_mgr = alife()
	if not alife_mgr then 
		return 
	end

	for _, name in ipairs(target_names) do
		local story_id = get_story_object_id(name)
		if story_id then
			local se_obj = alife_mgr:object(story_id)
			if se_obj then
				alife_mgr:set_switch_offline(se_obj.id, false)
				alife_mgr:set_switch_online(se_obj.id, true)
				
				local client_obj = level.object_by_id(se_obj.id)
				if client_obj then
					xr_logic.initialize_obj(client_obj, db.storage[se_obj.id], false, db.actor, modules.stype_restrictor)
					--printf("---  Reparsed online restrictor: %s", name)
				else
					CreateTimeEvent(0, "delay_activator_init_" .. se_obj.id, 1, function()
						local delayed_client = level.object_by_id(se_obj.id)
						if delayed_client then
							xr_logic.initialize_obj(delayed_client, db.storage[se_obj.id], false, db.actor, modules.stype_restrictor)
						end
						return true
					end)
				end
			end
		end
	end
end

function on_game_start()
	RegisterScriptCallback("on_game_load", function()
		CreateTimeEvent(0, "run_automated_restoration_delayed", 5, function()
			restore_map_activators()
			return true
		end)
	end)
	--[[
	RegisterScriptCallback("on_key_press", on_key_press)
	]]
end

--[[
local function on_key_press(key)
    if key == DIK_keys.DIK_T then
        print_all_map_restrictors()
    end
end

function print_all_map_restrictors()
    local current_level = level.name()
    local alife_mgr = alife()
    if not alife_mgr then 
        printf("~ [DUMP] Error: No A-Life")
        return 
    end

    printf("~ [DUMP] Scanning level: %s", current_level)

    for id = 1, 65534 do
        local se_obj = alife_mgr:object(id)
        if se_obj then
            local name = se_obj:name()
            if string.find(name, "space_restrictor") then
                local story_id = se_obj.story_id or "NO_STORY_ID"
                printf("~ [DUMP] Found Restrictor: Name -> '%s' | StoryID -> %s | ID -> %d", name, tostring(story_id), id)
            end
        end
    end
    printf("~ [RESTR_DUMP] Scan done: %s", current_level)
end
]]
