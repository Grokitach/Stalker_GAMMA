delay = 350

local last_slot = -1
local last_bag = nil

local key_state = key_state
local level_object_by_id = level.object_by_id

local LSHIFT = DIK_keys.DIK_LSHIFT
local RSHIFT = DIK_keys.DIK_RSHIFT

local inv = nil

local enabled = {
	actor_bag = true,
	npc_bag = true,
	actor_trade = true,
	actor_trade_bag = true,
	npc_trade = true,
	npc_trade_bag = true
}

function delay_change( name, path)
	if not (name ~= "UIInventory" or name ~= "UIItemSheet" or name ~= "UIWorkshop" )  then return end

	if  ui_inventory.GUI  then
		ui_inventory.GUI.item_info.delay = delay
		ui_inventory.GUI.upgr_info.delay = delay
	end

	if  ui_itm_details.GUI  then
		ui_itm_details.GUI.item_info.delay = delay
		ui_itm_details.GUI.upgr_info.delay = delay
		ui_itm_details.GUI.hint_wnd.delay = delay
	end
	if  ui_workshop.GUI  then
		ui_workshop.GUI.item_info.delay = delay
		ui_workshop.GUI.upgr_info.delay = delay
	end
end

function Suppress_Tooltip()
	if not inv then
		inv = ui_inventory.GUI
	end
	if not inv then return end

	if key_state(LSHIFT) ~= 0 or key_state(RSHIFT) ~= 0 then
		if inv.item_info and inv.item_info:IsShown() then
			inv.item_info:Show(false)
		end
		if inv.upgr_info and inv.upgr_info:IsShown() then
			inv.upgr_info:Show(false)
		end
	end
end

function Ishy_On_Hover(self, idx)
	if not idx then
		return Base_On_Hover(self, idx)
	end

	if key_state(LSHIFT) == 0 and key_state(RSHIFT) == 0 then
		last_slot = -1
		last_bag = nil
		return Base_On_Hover(self, idx)
	end

	local bag = self.ID
	if not enabled[bag] then
		return Base_On_Hover(self, idx)
	end

	if last_slot == idx and last_bag == bag then
		Suppress_Tooltip()
		return
	end

	last_slot = idx
	last_bag = bag

	Suppress_Tooltip()
	Move_Items_Fast(bag, idx)
end

function Move_Items_Fast(bag, idx)
	if not inv then
		inv = ui_inventory.GUI
	end

	local container = inv.CC[bag]
	if not container then return end

	local obj = container:GetObj(idx)
	if not obj then return end

	utils_ui.UICellContainer.On_Hover = Base_On_Hover

	local target_bag, _ = inv:Picker_Ownership(bag, idx, obj)

	if target_bag and inv:Cond_Move(obj, target_bag) then
		if inv:Cond_Childs(obj, target_bag) then
			local ci = container:GetCell_ID(obj:id())
			local items_to_move = {}
			local count = 0

			if ci and ci.childs then
				for id, _ in pairs(ci.childs) do
					count = count + 1
					items_to_move[count] = id
				end
			end
			count = count + 1
			items_to_move[count] = obj:id()

			for i = 1, count do
				local item_obj = level_object_by_id(items_to_move[i])
				if item_obj then
					inv:Action_Move(item_obj, target_bag)
				end
			end
		else
			inv:Action_Move(obj, target_bag)
		end
	end

	utils_ui.UICellContainer.On_Hover = Ishy_On_Hover
end

function on_game_start()
	inv = ui_inventory.GUI
	Base_On_Hover = utils_ui.UICellContainer.On_Hover
	utils_ui.UICellContainer.On_Hover = Ishy_On_Hover
	RegisterScriptCallback("GUI_on_show", delay_change)
end
