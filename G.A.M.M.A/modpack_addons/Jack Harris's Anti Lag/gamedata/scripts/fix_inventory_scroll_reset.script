-- Script by Siba Inu Maska

local orig_On_Scroll = nil

local function clean_scroll_patch()
	if not (utils_ui and utils_ui.UICellContainer) then return end
	orig_On_Scroll = utils_ui.UICellContainer.On_Scroll
	utils_ui.UICellContainer.On_Scroll = function(self, ...)
		if self.scroll then
			local current_engine_pos = self.scroll:GetCurrentScrollPos() or 0
			if not self.scroll_pos then
				self.scroll_pos = current_engine_pos
			end
			local saved_tracking_pos = self.scroll_pos or 0
			local step = (self.grid_size + self.grid_line) * self.scolling_power

			if step and step > 0 then
				if self.fix_want then
					local max_pos = self.scroll:GetMaxScrollPos() or 0
					local target = math.min(self.fix_want, max_pos)

					if math.abs(current_engine_pos - target) <= step and math.abs(saved_tracking_pos - target) <= step then
						self.fix_want = nil
					else
						self.scroll_pos = target
						self:Scroll_SetPos(target, true)
						return
					end

				elseif math.abs(current_engine_pos - saved_tracking_pos) > step then
					if saved_tracking_pos > 0 then
						self.fix_want = saved_tracking_pos
						return
					end
				end
			end
		end
		return orig_On_Scroll(self, ...)
	end
end

function on_game_start()
	clean_scroll_patch()
end