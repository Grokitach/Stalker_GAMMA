[logic@bar_guard2]
active = walker
suitable = {=check_npc_name(bar_visitors_zhorik_stalker_guard2)} true
prior = 100
on_combat = combat@bar_guard2

[combat@bar_guard2]
on_info = {-bar_guards_alarm} %+bar_guards_alarm%

[walker]
path_walk = guard2_walk
path_look = guard2_look
meet = meet@bar_guard_2
danger = danger_ignore
combat_ignore_cond = {=check_enemy_name(actor) !actor_true_enemy} true, false
invulnerable = {=is_warfare} false, {!actor_true_enemy} true, false
on_info = {+bar_guards_alarm !has_enemy} walker@guard2_alert
corpse_detection_enabled = false
gather_items_enabled = false
help_wounded_enabled = false

[walker@guard2_alert]:walker
def_state_standing = threat_na
on_info = nil
on_game_timer = 150 | {!has_enemy} walker %-bar_guards_alarm%

[meet@bar_guard_2]
close_distance = 5
close_victim = actor
close_anim = guard
close_snd_hello = bar_guard_prohodi
close_snd_distance = 5
use = false
use_wpn = false
abuse = false

[danger_ignore]
ignore_distance = 0
