-- removes legacy mcm menus for all addons
if extended_movement_sounds_mcm and grok_casings_sounds_mcm.VERSION and grok_casings_sounds_mcm.VERSION >= 5 then grok_casings_sounds_mcm.on_mcm_load = function() end end
if extended_movement_sounds_mcm and extended_movement_sounds_mcm.VERSION and extended_movement_sounds_mcm.VERSION >= 5 then extended_movement_sounds_mcm.on_mcm_load = function() end end
if oleh_misc_sounds_mcm then oleh_misc_sounds_mcm.on_mcm_load = function() end end

