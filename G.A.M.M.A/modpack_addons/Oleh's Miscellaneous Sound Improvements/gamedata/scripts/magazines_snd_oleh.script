if not magazines then return end
printf("loading monkeypatch: magazines_snd_oleh")

-- removes ammo pickup sound during Magazines reload
refund_ammo = magazines.refund_ammo
function magazines.refund_ammo(...)
	if itms_manager.timeout_snd_on_take then
		itms_manager.timeout_snd_on_take()
	end
	refund_ammo(...)
end