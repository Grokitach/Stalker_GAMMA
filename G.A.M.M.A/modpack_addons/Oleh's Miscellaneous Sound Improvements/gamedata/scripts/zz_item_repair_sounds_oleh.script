if not item_repair then return end
printf("loading monkeypatch: zz_item_repair_sounds_oleh")

OnRepair = item_repair.UIRepair.OnRepair
item_repair.UIRepair.OnRepair = function(self)
	OnRepair(self)
	if itms_manager.play_use_sound and not ui_options.get("video/player/animations") then
		itms_manager.play_use_sound(self.obj)
	end
end