if not item_repair then return end
printf("loading monkeypatch: item_repair_sounds_oleh")

Reset = item_repair.UIRepair.Reset
item_repair.UIRepair.Reset = function(self, obj, section)
	Reset(self, obj, section)
	if not ui_options.get("video/player/animations") then
		itms_manager.play_item_sound(obj)
	end
end