local whitelisted_maps = {
    ["l10_limansk"] = true,
    ["l12_stancia"] = true,
    ["l12_stancia_2"] = true,
    ["l11_pripyat"] = true,
    ["pripyat"] = true,
}

local orig_set_scheme = xr_camper.set_scheme
function xr_camper.set_scheme(npc, ini, scheme, section, gulag_name)
    if npc and IsStalker(npc) and npc:alive() and whitelisted_maps[level.name()] then
        local path_walk = ini:r_string_ex(section, "path_walk") or ""
        local sec_name = npc:section() or ""
        local npc_name = npc:name() or ""
        local combined = string.lower(section .. " " .. path_walk .. " " .. sec_name .. " " .. npc_name)

        if string.find(combined, "sniper")
           and not string.find(combined, "isg")
           and not string.find(combined, "hall") then
            local id = npc:id()
            CreateTimeEvent("sniper_cleaner", "del_" .. id, 0, function() -- Busyhands prevention
                local se_npc = alife_object(id)
                if se_npc then
                    printf("// Deleted a problematic sniper NPC: %s (path: %s)", se_npc:name(), path_walk)
                    alife_release(se_npc)
                end
                return true
            end)
        end
    end

    return orig_set_scheme(npc, ini, scheme, section, gulag_name)
end
