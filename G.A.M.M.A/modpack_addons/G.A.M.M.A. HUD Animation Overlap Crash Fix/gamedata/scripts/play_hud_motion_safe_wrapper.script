local play_hud_motion = game.play_hud_motion

function on_game_start()
    game.play_hud_motion = function(hands, section, ...)
        if not game.hud_motion_allowed() and not ini_sys:line_exist(section, "item_visual") then
            game.stop_hud_motion()
        end
        return play_hud_motion(hands, section, ...)
    end
end
