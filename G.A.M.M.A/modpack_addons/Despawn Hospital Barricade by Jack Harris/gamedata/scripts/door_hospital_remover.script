local target_name = "hospital_wooden_board_01_0000"
local info_flag = "hospital_wooden_board_0000_despawned"

function actor_on_first_update()
	if has_alife_info(info_flag) or level.name() ~= "l11_hospital" then 
		return 
	end

	for id = 1, 65534 do
		local se_obj = alife_object(id)
		if se_obj and se_obj:name() == target_name then
			alife_release_id(id)
			db.actor:give_info_portion(info_flag)
			printf("Permanently removed '%s' (ID: %s)", target_name, id)
			break
		end
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end
