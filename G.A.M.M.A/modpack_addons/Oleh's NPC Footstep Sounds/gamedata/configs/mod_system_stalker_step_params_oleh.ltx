; oleh5230, 06.08.26
; custom step parameters for stalker NPCs (increased power for louder footsteps)

![stalker]
step_params				= stalker_npc_step_manager

[stalker_npc_step_manager]
; order: left, right
;--------------------------------------------------------------------------
;	animation				Cycles	| time1 | power1 | time2 | power2 |
;--------------------------------------------------------------------------
; 'ls' and 'rs' are left and right diagonal strafes respectively
; NPCs strafe sideways or backwards only in combat I believe

; wounded, used in some addons, unused in vanilla
dmg_norm_escape_0			=	1,	  0.2,	    1.0,   0.65,     1.0
dmg_norm_walk_fwd_1			=	1,	  0.2,	    0.4,   0.65,     0.4
