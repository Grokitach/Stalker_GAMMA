function clear_old_artefacts()
	-- run_verification()

	if not db.actor then return end

	local actor_id = db.actor:id()
	local sim = alife()
	if not sim then return end

	if bind_anomaly_zone and bind_anomaly_zone.parent_zones_by_artefact_id then
		for id, _ in pairs(bind_anomaly_zone.parent_zones_by_artefact_id) do
			tracked_loose_artefacts[id] = true
		end
	end

	if db.storage then
		for id, _ in pairs(db.storage) do
			local se_obj = sim:object(id)
			if se_obj and IsArtefact(se_obj) then
				tracked_loose_artefacts[id] = true
			end
		end
	end

	local current_level_id = level.name()
	local local_displays = (weapon_showcase and weapon_showcase.weapon_displays) or {}

	for id, _ in pairs(tracked_loose_artefacts) do
		local se_obj = sim:object(id)
		if se_obj and IsArtefact(se_obj) then
			process_se_artefact(se_obj, actor_id, sim, current_level_id, local_displays)
		else
			tracked_loose_artefacts[id] = nil
			artefacts_spawned_time[id] = nil
		end
	end
end

local function delayed_clear_old_artefacts()
	CreateTimeEvent("af_despawner", "clear_old_artefacts", 3, function()
		clear_old_artefacts()
		return true
	end)
end

function delete_artefacts(artefact)
	local curr_time = game.get_game_time()
	if not artefact then return end

	local af_id = artefact.id
	local af_sec = artefact:section_name()

	if not artefacts_spawned_time[af_id] then
		artefacts_spawned_time[af_id] = c2t(curr_time)
		return
	end

	local spawn_time_diff = curr_time:diffSec(t2c(artefacts_spawned_time[af_id]))

	if spawn_time_diff >= af_spawn_duration_limit and not ah_af_sections[af_sec] then
		if bind_anomaly_zone then
			local zone = bind_anomaly_zone.parent_zones_by_artefact_id[af_id]
			bind_anomaly_zone.parent_zones_by_artefact_id[af_id] = nil
			bind_anomaly_zone.artefact_ways_by_id[af_id] = nil
			bind_anomaly_zone.artefact_points_by_id[af_id] = nil
			if zone then
				zone.artefact_ways_by_id[af_id] = nil
				zone.artefact_points_by_id[af_id] = nil
				zone.spawned_count = zone.spawned_count - 1
				if zone.spawned_count < 0 then
					zone.spawned_count = 0
				end
			end
		end
		alife_release(artefact)
		artefacts_spawned_time[af_id] = nil
		tracked_loose_artefacts[af_id] = nil
	end
end

function actor_on_item_drop(item)
	if item and IsArtefact(item) then
		local sec = item:section()
		local kind = SYS_GetParam(0, sec, "kind")
		if kind == "i_arty_junk" or kind == "i_arty" then
			cache_loose_artefact(item:id())
		end
	end
end

function actor_on_item_take(item)
	if item and IsArtefact(item) then
		local id = item:id()
		tracked_loose_artefacts[id] = nil
		artefacts_spawned_time[id] = nil
	end
end

function save_state(m_data)
	m_data.af_despawner_times = artefacts_spawned_time
	m_data.af_despawner_tracked = tracked_loose_artefacts
end

function load_state(m_data)
	artefacts_spawned_time = m_data.af_despawner_times or {}
	tracked_loose_artefacts = m_data.af_despawner_tracked or {}
end

function on_game_start()
	hook_artefact_net_spawn()
	RegisterScriptCallback("actor_on_first_update", delayed_clear_old_artefacts)
	RegisterScriptCallback("actor_on_item_drop", actor_on_item_drop)
	RegisterScriptCallback("actor_on_item_take", actor_on_item_take)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
end
