local af_spawn_duration_limit = 259200 -- time in game time seconds after which artefacts are released if not looted ; 86400 = how many seconds in 1 day

local ah_af_sections = {
	["af_ah_e1"] = true,
	["af_ah_e2"] = true,

	["af_ah_f1"] = true,

	["af_ah_g1"] = true,
	["af_ah_g2"] = true,

	["af_ah_h1"] = true,
	["af_ah_h2"] = true,

	["af_ah_o1"] = true,
	["af_ah_o2"] = true,

	["af_ah_r1"] = true,
	["af_ah_r2"] = true,
	["af_ah_r3"] = true,
	["af_ah_r4"] = true,
	["af_ah_r5"] = true,

	["af_ah_s1"] = true,

	["af_black"] = true,
	["monolith_shard"] = true,
	["misery_bread"] = true,
	["af_oasis_heart"] = true,
}

local artefacts_spawned_time = {}
local tracked_loose_artefacts = {}

function t2c(t)
	if not t then return nil end
	local ct = game.CTime()
	ct:set(t.Y, t.M, t.D, t.h, t.m, t.s, t.ms)
	return ct
end

function c2t(ct)
	if not ct then return nil end
	local Y, M, D, h, m, s, ms = 0, 0, 0, 0, 0, 0, 0
	Y, M, D, h, m, s, ms = ct:get(Y, M, D, h, m, s, ms)
	return {
		Y = Y,
		M = M,
		D = D,
		h = h,
		m = m,
		s = s,
		ms = ms
	}
end

local function is_in_display(id, displays)
	if not displays then return false end
	for _, case_items in pairs(displays) do
		for _, world_id in pairs(case_items) do
			if world_id == id then
				return true
			end
		end
	end
	return false
end

local function cache_loose_artefact(af_id)
	tracked_loose_artefacts[af_id] = true
	if not artefacts_spawned_time[af_id] then
		artefacts_spawned_time[af_id] = c2t(game.get_game_time())
	end
end

local function wrap_binder_net_spawn(binder_tbl)
	if binder_tbl and binder_tbl.net_spawn then
		local base_net_spawn = binder_tbl.net_spawn
		binder_tbl.net_spawn = function(self, se_abstract)
			local res = base_net_spawn(self, se_abstract)
			if res and se_abstract then
				local sim = alife()
				local se_obj = sim and sim:object(se_abstract.id)
				if se_obj and IsArtefact(se_obj) then
					local af_sec = se_obj:section_name()
					local kind = SYS_GetParam(0, af_sec, "kind")
					if (kind == "i_arty_junk" or kind == "i_arty") and (se_obj.parent_id or 65535) >= 65535 then
						cache_loose_artefact(se_obj.id)
					end
				end
			end
			return res
		end
	end
end

local function hook_artefact_net_spawn()
	wrap_binder_net_spawn(item_artefact and item_artefact.artefact_binder)
	wrap_binder_net_spawn(bind_artefact and bind_artefact.artefact_binder)
end

local function process_se_artefact(se_obj, actor_id, sim, current_level_id, local_displays)
	local af_id = se_obj.id
	local af_sec = se_obj:section_name()
	local kind = SYS_GetParam(0, af_sec, "kind")
	if kind ~= "i_arty_junk" and kind ~= "i_arty" then
		tracked_loose_artefacts[af_id] = nil
		artefacts_spawned_time[af_id] = nil
		return
	end

	local artifact_level = sim:level_name(game_graph():vertex(se_obj.m_game_vertex_id):level_id())
	if artifact_level ~= current_level_id then
		return
	end

	local parent_id = se_obj.parent_id
	local is_owned = false

	if parent_id and parent_id < 65535 then
		local se_parent = sim:object(parent_id)
		if parent_id == actor_id or IsStalker(se_parent) or IsInvbox(se_parent) or IsMonster(se_parent) then
			is_owned = true
		end
	end

	if not is_owned and is_in_display(af_id, local_displays) then
		is_owned = true
	end

	if is_owned then
		tracked_loose_artefacts[af_id] = nil
		artefacts_spawned_time[af_id] = nil
	else
		delete_artefacts(se_obj)
	end
end

