local af_detected = 0
local grok_delay = 0
local delay = 921
local trigger = 0
local af_detection_dist = 500

local detectors = {
	["detector_simple"] = 1,
	["detector_advanced"] = 2,
	["detector_grizzly"] = 3,
	["detector_elite"] = 3,
	["detector_scientific"] = 3,
}

-- add junk artefacts as well
local af_by_tiers = {
	["af_black"] = 1,
	["af_dragon_eye"] = 1,
	["af_ball"] = 1,
	["af_fonar"] = 1,
	["af_tapeworm"] = 1,
	["af_moh"] = 1,
	["af_serofim"] = 1,
	["af_elektron"] = 1,
	["af_kogot"] = 1,
	["af_generator"] = 1,
	["af_black_angel"] = 1,
	["af_grapes"] = 1,
	["af_skull_miser"] = 1,
	["af_star_phantom"] = 1,
	["af_medallion"] = 1,
	["af_peas"] = 1,
	["af_kislushka"] = 1,
	["af_zhelch"] = 1,
	["af_sandstone"] = 1,
	["af_fountain"] = 1,
	["af_spaika"] = 1,
	["af_signet"] = 1,
	["af_repei"] = 1,
	["af_bat"] = 1,
	["af_sun"] = 1,
	["af_ear"] = 1,
	["af_chelust"] = 1,
	["af_atom"] = 1,
	["af_lighthouse"] = 1,
	["af_cell"] = 1,
	["af_cocoon"] = 1,
	["af_pin"] = 1,
	["af_medusa"] = 1,
	["af_vyvert"] = 2,
	["af_empty"] = 2,
	["af_full_empty"] = 3,
	["af_dummy_glassbeads"] = 1,
	["af_cristall"] = 2,
	["af_lobster_eyes"] = 2,
	["af_fireball"] = 3,
	["af_fire"] = 3,
	["af_night_star"] = 1,
	["af_gravi"] = 2,
	["af_gold_fish"] = 3,
	["af_mincer_meat"] = 1,
	["af_dummy_battery"] = 1,
	["af_electra_sparkler"] = 1,
	["af_ring"] = 2,
	["af_electra_moonlight"] = 2,
	["af_sponge"] = 2,
	["af_electra_flash"] = 3,
	["af_ice"] = 3,
	["af_blood"] = 1,
	["af_cristall_flower"] = 2,
	["af_bracelet"] = 2,
	["af_baloon"] = 3,
	["af_soul"] = 1,
	["af_fuzz_kolobok"] = 2,
	["af_eye"] = 2,
	["af_glass"] = 3,
	["af_dummy_dummy"] = 2,
	["af_black_spray"] = 3,
	["af_compass"] = 3,
	["af_oasis_heart"] = 3,
	["af_monolith"] = 3,
	["af_fire_loop"] = 3,
}

function on_option_change()
	if not (grok_artefacts_bip_mcm and grok_artefacts_bip_mcm.get_config) then
		return
	end

	if not grok_artefacts_bip_mcm.get_config("enabled") then
		af_detected = 0
	end
end

function actor_on_first_update()
	actor_status.add_indicator("Artefact", { index = 16, typ = "state", functor = {"grok_artefacts_bip","get_artefact",true}, icon = "ui\\alticons\\ArtefactIndicator.dds", background = "ui\\alticons\\bg1.dds", anim_icon = true, anim_bk = false })
end

function actor_on_update()
	if not (grok_artefacts_bip_mcm and grok_artefacts_bip_mcm.get_config) then
		return
	end

	if not grok_artefacts_bip_mcm.get_config("enabled") then
		af_detected = 0
		return
	end

	local tg = time_global()
	if trigger == 0 then
		grok_delay = tg + delay
		trigger = 1
	end

	if (trigger == 1 and tg > grok_delay) then
		trigger = 0
		local available_det_tier = 0

		local mode = grok_artefacts_bip_mcm.get_config("mode") or "slot"
		local extended = grok_artefacts_bip_mcm.get_config("extended_range")
		local current_dist = extended and 910 or af_detection_dist

		local det = nil

		if mode == "passive" then
			db.actor:iterate_inventory(function(npc, item)
				local sec = item:section()
				if detectors[sec] and detectors[sec] > available_det_tier then
					available_det_tier = detectors[sec]
				end
			end)
		else
			det = db.actor:item_in_slot(9)
			if det then
				local sec = det:section()
				if sec and detectors[sec] then
					available_det_tier = detectors[sec]
				end
			end
		end

		if available_det_tier > 0 and zz_item_artefact.dist_t then
			for af, dist in pairs(zz_item_artefact.dist_t) do
				if dist and dist >= 0.1 and af_by_tiers[af] and (af_by_tiers[af] <= available_det_tier) and (dist < current_dist) then
					af_detected = 1
					return
				end
			end
		end

		af_detected = 0
	end
end

function get_artefact(visual)
	local artefact = af_detected

	if not visual then
		return artefact
	end

	if artefact >= 1 then
		af_detected = 0
		return 1
	end

	af_detected = 0
	return 0
end

function on_game_start()
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end
