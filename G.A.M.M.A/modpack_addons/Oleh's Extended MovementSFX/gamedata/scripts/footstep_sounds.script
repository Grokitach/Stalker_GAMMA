-- plays player footstep sounds - oleh5230, 17.08.25
-- Last edit: 21.09.25
-- credits: ascii1457 - get_move_state()

local debug = false

local step_enabled = true
local step_volume = 0.5
local gear_enabled = true
local gear_volume = 0.5
local backpack_enabled = true
local backpack_volume = 0.5
local servo_enabled = true
local servo_volume = 0.5
local servo_legacy = false
local ice_patch = false
local grass_patch = false

local utils = oleh_sound_utils
local exo_path = servo_legacy and "exo_legacy\\servo_exo_walk_" or "exo\\servo_exo_walk_"
local ssfx = ssfx_rain_footsteps and ssfx_rain_footsteps.module_installed

-- number of footstep sound files (samples) per class
limit = {
    ["crouch"] = 6,
    ["sprint"] = 6,
    ["walk"] = 6,

    ["cloth\\cloth_crouch"] = 9,
    ["cloth\\cloth_walk"] = 9,
    ["cloth\\cloth_sprint"] = 9,
    ["gear_rattle\\gear_rattle"] = 6,
    ["backpack\\backpack_sprint"] = 16,
    ["backpack\\backpack_walk"] = 16,

    ["hand-0"] = 6,
    ["foot-0"] = 6,
}

common_mats = {
    ["grass_"] = true,
    ["dirt_"] = true,
    ["asphalt_"] = true,
}

function actor_on_footstep(material, power, hud_view, flags)
    -- footstep callback is being sent upon landing (sometimes even twice)
    if utils.land_tg + 200 > time_global() then return end
    --printf("%s", material)

    --flags.ret_value = false -- uncomment to disable engine footstep sounds
    local move_state, volume = get_move_state()
    local _material = grass_patch and utils.is_actually_grass(material) and available_materials["materials\\grass"]
    or available_materials[material] or available_materials["default"]

    -- play extra gear sounds
    play_cloth_sound(volume, move_state)
    play_gear_rattle(volume, move_state)
    play_exo_servo_sound(volume, move_state)

    if not step_enabled then return end

    if IsMoveState('mcClimb') and play_ladder_sound(_material, volume) then
    -- callback can't detect 'water_radiation' material, leave water steps to engine
    elseif _material ~= "water_" then
        play_footstep_sound(_material, volume, move_state)
        -- play puddle splash
        if ssfx and puddle_materials[material] then
            ssfx_rain_footsteps.actor_on_footstep()
        end
    end
end

local last_fs = 0
function play_footstep_sound(material, volume, move_state)

    local _limit = common_mats[material] and move_state == "sprint" and 16 or limit[move_state]
    local roll = math.random(_limit)
    if roll == last_fs then
        roll = last_fs % _limit + 1
    end
    last_fs = roll

    local sound = sound_object("footstep\\" .. material .. move_state .. roll)
    --printf("footstep_sounds: %s, volume: %s", "footstep\\" .. material .. move_state .. roll, volume * step_volume)
    sound:play(db.actor, 0, sound_object.s2d)
    sound.volume = volume * step_volume

end

local last_cl = 0
function play_cloth_sound(volume, move_state)
    if not gear_enabled then return end
    local cloth = "cloth\\cloth_" .. (move_state or "walk")

    local roll = math.random(limit[cloth])
    -- if roll == last_cl then
    --     roll = last_cl % (limit[cloth] + 1)
    -- end
    -- last_cl = roll

    local sound = sound_object(cloth .. roll)
    sound:play(db.actor, 0, sound_object.s2d)
    sound.volume = gear_volume * (volume or 1)
    --printf("%s, volume: %s", cloth .. roll, sound.volume)
end

local last_gr = 0
local gear = "gear_rattle\\gear_rattle"
local backpack = "backpack\\backpack_sprint"
function play_gear_rattle(volume, move_state)
    if not backpack_enabled then return end

    local roll = math.random(limit[gear])
    -- if roll == last_gr then
    --     roll = last_gr % (limit[gear] + 1)
    -- end
    -- last_gr = roll

    local sound = sound_object(gear .. roll)
    sound:play(db.actor, 0, sound_object.s2d)
    sound.volume = gear_volume * 0.5 * (volume or 1)
    --printf("%s, volume: %s", gear .. roll, sound.volume)

    if move_state == "sprint" then
        play_backpack_rattle(volume, move_state)
    end
end

local last_bp = 0
function play_backpack_rattle(volume, move_state)
    if not backpack_enabled then return end

    local roll = math.random(limit[backpack])
    if roll == last_bp then
        roll = last_bp % (limit[backpack] + 1)
    end
    last_bp = roll

    -- volume based on carry weight
    local weight = utils.total_weight or 10
    local max_weight = utils.max_weight or 60
    local weight_volume = clamp((weight/max_weight), 0, 1)
    if weight_volume < 0.3 then return end

    local sound = sound_object(backpack .. roll)
    sound:play(db.actor, 0, sound_object.s2d)
    sound.volume = 0.75 * weight_volume * backpack_volume * (volume or 1)
    --printf("%s, volume: %s, weight: %s, max_weight: %s", weight_volume, sound.volume, weight, max_weight)
end

local last_exo = false
function play_exo_servo_sound(volume, move_state)
    local exo_class = utils.exo_classes[utils.outfit.class]
    if servo_enabled and exo_class then
        local sound = sound_object(exo_path .. exo_class .. (last_exo and 2 or 1))
        sound:play(db.actor, 0, sound_object.s2d)
        sound.volume = servo_volume * (volume or 1)
        last_exo = not last_exo
    end
end

-- SSS rain footsteps hijack
if ssfx then
    ssfx_rain_footsteps.RegisterScriptCallback = function(name,func_or_userdata)
        if name == "actor_on_jump" or name == "actor_on_land" or name == "actor_on_footstep" then
        else
            RegisterScriptCallback(name,func_or_userdata)
        end
    end

    ssfx_get_setting = ssfx_001_mcm.ssfx_get_setting
    ssfx_001_mcm.ssfx_get_setting = function(module_name, var_name, default_script)
        if var_name == "multi_no_rain" then
            return 1
        elseif var_name == "main_vol" then
            return 0
        else
            return ssfx_get_setting(module_name, var_name, default_script)
        end
    end
end

local raycast_count = 5
local part_count = false
function play_ladder_sound(material, volume)
    local ladder_material = ladder_fake_materials[material]
    -- cast ray to get ladder material (fake ladder materials are inconsistent)
    for i=1,raycast_count do
        local ray_material = ladder_materials[get_ladder_material(0.175 + i * 0.075, 0.15 + i * 0.075)]
        if ray_material then ladder_material = ray_material break end
    end
    if not ladder_material then return false end

    -- play foot/hand sound effect sequentially
    local part = part_count and "foot-0" or "hand-0"

    local step_snd = sound_object("ladder\\" .. ladder_material .. part .. math.random(limit[part]))
    step_snd:play(db.actor, 0, sound_object.s2d)
    step_snd.volume = step_volume * 2 * (volume or 1)
    part_count = not part_count

    -- play ladder rattle sound effect
    --local detail_snd = sound_object("ladder\\" .. ray_material .. "detail_" .. "1")
    --detail_snd:play(db.actor, 0, sound_object.s2d)
    --detail_snd.volume = step_volume * volume
    return true
end

function get_ladder_material(offset_x, offset_z)
    local pos = db.actor:position()
    local dir = db.actor:direction()

    -- offset position in the camera direction
    local offset_pos = vector():set(pos.x + dir.x * offset_x, pos.y + 0.5, pos.z + dir.z * offset_z)

    -- perpendicular direction using cross product with up vector
    local up = vector():set(0, 1, 0)
    local perpendicular = vector_cross(dir, up)
    perpendicular:normalize()

    local material = ray_cast(offset_pos, perpendicular, 1, debug)

    return material
end

function get_move_state()
    local state_bit = level.actor_moving_state()
    local move_state = "walk"
    local volume = 1

    if bit_and(state_bit, 4096) ~= 0 then
        move_state = "sprint"
        volume = 1.7

    elseif bit_and(state_bit, 16) ~= 0 then
        move_state = "walk"
        volume = 0.5
        if bit_and(state_bit, 32) ~= 0 then
            move_state = "walk"
            volume = 0
        end

    elseif bit_and(state_bit, 32) ~= 0 then
        move_state = "walk"
        volume = 0.3
    end

    -- if IsMoveState('mcClimb') then
    --     move_state = "climb_"
    --     volume = 1
    -- end

    return move_state, volume
end

function ray_cast(pos, dir, range, visualize)
    local ray = demonized_geometry_ray.geometry_ray({
        ray_range = range or 0.5,
        flags = 1 + 2 + 4 + 8,
        ignore_object = db.actor,
        visualize = visualize or false,
    })
    return ray:get(pos, dir).result.material_name
end

function load_settings()
    if ui_mcm and oleh_sounds_mcm and oleh_sounds_mcm.on_mcm_load then
        step_enabled        = ui_mcm.get("oleh_sounds/movement/enabled_footstep_sounds")
        step_volume         = ui_mcm.get("oleh_sounds/movement/volume_footstep_sounds") or 0.5
        gear_enabled        = ui_mcm.get("oleh_sounds/movement/enabled_gear_rustle_sounds")
        gear_volume         = ui_mcm.get("oleh_sounds/movement/volume_gear_rustle_sounds") or 0.5
        backpack_enabled    = ui_mcm.get("oleh_sounds/movement/enabled_backpack_rustle_sounds")
        backpack_volume     = ui_mcm.get("oleh_sounds/movement/volume_backpack_rustle_sounds") or 0.5
        servo_enabled       = ui_mcm.get("oleh_sounds/movement/enabled_servo_sounds")
        servo_volume        = ui_mcm.get("oleh_sounds/movement/volume_servo_sounds") or 0.5
        servo_legacy        = ui_mcm.get("oleh_sounds/movement/legacy_servo_sounds")

        ice_patch = ui_mcm.get("oleh_sounds/general/ice_patch")
        grass_patch = ui_mcm.get("oleh_sounds/general/grass_patch")

    elseif ui_mcm and extended_movement_sounds_mcm and extended_movement_sounds_mcm.on_mcm_load then
        step_enabled  = ui_mcm.get("extended_movement_sounds/enabled_footstep_sounds")
        step_volume   = ui_mcm.get("extended_movement_sounds/volume_footstep_sounds") or 0.5
        gear_enabled  = ui_mcm.get("extended_movement_sounds/enabled_gear_rustle_sounds")
        gear_volume   = ui_mcm.get("extended_movement_sounds/volume_gear_rustle_sounds") or 0.5
        servo_enabled = ui_mcm.get("extended_movement_sounds/enabled_servo_sounds")
        servo_volume  = ui_mcm.get("extended_movement_sounds/volume_servo_sounds") or 0.5
    end

    exo_path = servo_legacy and "exo_legacy\\servo_exo_walk_" or "exo\\servo_exo_walk_"
    available_materials["creatures\\actor"] = ice_patch and "water_" or "dirt_"
end

function on_game_start()
    assert(oleh_sound_utils and oleh_sound_utils.VERSION and oleh_sound_utils.VERSION >= 6, "\n\n"..
    "MovementSFX: oleh_sound_utils.script is missing or outdated, update MSIG (Miscellaneous Sound Improvements) or move it to higher priority\nhttps://github.com/oleh5230/MSIG")

    RegisterScriptCallback("actor_on_footstep", actor_on_footstep)
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("on_option_change", load_settings)
    load_settings()
end

