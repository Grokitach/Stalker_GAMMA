-- in Swamps fake is used primarily for wood bridges
function actor_on_first_update()
    if level.name() == "k00_marsh" then
        available_materials["materials\\fake"] = "wood_plank_"
    else
        available_materials["materials\\fake"] = "asphalt_"
    end
end

