local debug = false

local volume = 0.5
local enabled = true
local servo_volume = 0.5
local servo_enabled = true
local servo_legacy = false
local ice_patch = false
local grass_patch = false

local jump_sound, land_sound
local exo_jump = servo_legacy and "exo_legacy\\servo_exo_jump_" or "exo\\servo_exo_jump_"
local exo_land = servo_legacy and "exo_legacy\\servo_exo_land_" or "exo\\servo_exo_land_"

local utils = oleh_sound_utils
local gear_rattle = footstep_sounds and footstep_sounds.play_gear_rattle and footstep_sounds.play_cloth_sound
local wpn_rattle = eft_rattle and eft_rattle.play_sprint_rattle_sound

local ssfx = ssfx_rain_footsteps and ssfx_rain_footsteps.module_installed
local Footstep_Jump_Snd = {}
local Footstep_Land_Snd = {}

local last_jump = 0
function actor_on_jump()
    if not enabled then return end

    local roll = math.random(3)
    if roll == last_jump then
        roll = last_jump % 4
    end
    last_jump = roll

    local material = get_material(debug)
    local _material = available_materials[material]
    if not _material then return false end
    jump_sound = sound_object("jump\\jump_" .. _material .. roll)
    jump_sound:play(db.actor, 0, sound_object.s2d)
    jump_sound.volume = volume

    -- play gear rattle
    if gear_rattle then
        footstep_sounds.play_gear_rattle(1, "sprint")
        footstep_sounds.play_cloth_sound(1, "sprint")
    end

    -- play weapon rattle
    if wpn_rattle then
        eft_rattle.play_sprint_rattle_sound(1, 1)
    end

    -- play puddle splash
    if ssfx and puddle_materials[material] then
        ssfx_rain_footsteps.ssfx_JumpLand_Snd(Footstep_Jump_Snd, level.rain_wetness() * level.rain_hemi(), "jump")
    end

    -- play exo servo sounds
    local exo_class = utils.exo_classes[utils.outfit.class]
    if servo_enabled and exo_class then
        local sound = sound_object(exo_jump .. exo_class)
        sound:play(db.actor, 0, sound_object.s2d)
        sound.volume = servo_volume * 2
    end
end

local last_land = 0
function actor_on_land(landing_speed)
    if not enabled then return end

    -- hack for speed set to 0 by fake geometry
    if landing_speed == 0 then landing_speed = 6.66 end
    print_dbg("landing_speed: %s", landing_speed)
	if landing_speed < 2 then return end

    local roll = math.random(3)
    if roll == last_land then
        roll = last_land % 4
    end
    last_land = roll

    local speed_mod = clamp(landing_speed / 5, 0, 4)
    local material = get_material(debug)
    local _material = available_materials[material]
    if not _material then return false end
    land_sound = sound_object("landing\\landing_" .. _material .. roll)
    land_sound:play(db.actor, 0, sound_object.s2d)
    land_sound.volume = volume * speed_mod

    -- play gear rattle
    if gear_rattle then
        footstep_sounds.play_gear_rattle(2 * speed_mod, "sprint")
        -- footstep_sounds.play_cloth_sound(1, "sprint")
    end

    -- play weapon rattle
    if wpn_rattle then
        eft_rattle.play_sprint_rattle_sound(2 * speed_mod, 1)
    end

    -- play puddle splash
    if ssfx and puddle_materials[material] then
        ssfx_rain_footsteps.ssfx_JumpLand_Snd(Footstep_Land_Snd, level.rain_wetness() * level.rain_hemi(), "land")
    end

    -- play exo servo sounds
    local exo_class = utils.exo_classes[utils.outfit.class]
    if servo_enabled and exo_class then
        local sound = sound_object(exo_land .. exo_class)
        sound:play(db.actor, 0, sound_object.s2d)
        sound.volume = 2 * servo_volume * speed_mod
    end
end

local function get_highest_value(tbl)
    local max_key
    local max_value = 0
    for k,v in pairs(tbl) do
        if v and v > max_value then
            max_value = v
            max_key = k
        end
    end
    return max_key
end

local function ray_cast(pos, dir, range, visualize)
    local ray = demonized_geometry_ray.geometry_ray({
        ray_range = range or 0.5,
        flags = 3, --1 + 2 + 4 + 8,
        ignore_object = db.actor,
        visualize = debug and visualize or false,
    })
    return ray:get(pos, dir).result
end

-- vertical x-shaped raycast pattern;
-- radius is slightly smaller than player collision box (bubble?);
-- when editing y-offset, edit inversed ray offset too;
-- [index] = {x, y, z, range}
ray_cast_offsets = {
    [1] = {0, 1.0, 0, 1.25},
    [2] = {0.225, 0.25, 0.225, 0.5},
    [3] = {0.225, 0.25, -0.225, 0.5},
    [4] = {-0.225, 0.25, 0.225, 0.5},
    [5] = {-0.225, 0.25, -0.225, 0.5},
}

function get_material(print)
    local pos = db.actor:position()
    local material
    local ray_hits = {}

    for k,v in pairs(ray_cast_offsets) do
        local ray = ray_cast(vector():set(pos.x + v[1], pos.y + v[2], pos.z + v[3]), vector():set(0, -1, 0), v[4], print)
        material = ray.material_name

        -- dead bodies return water material somehow
        if ray.object and ray.object.clsid == 35 then
            material = "materials\\dirt"
        -- short circuit if centre ray hits water
        elseif k == 1 and water_materials[material] then
            return "materials\\water"
        end

        -- inversed ray cast to hit surfaces covered by fake geometry
        if fake_materials[material] then
            local inv_material = ray_cast(vector():set(pos.x, pos.y - 0.5, pos.z), vector():set(0, 1, 0), 0.5, print).material_name
            if inv_material then material = inv_material end
        end

        -- select material with most hits
        if material then
            if not ray_hits[material] then
                ray_hits[material] = 1
            else
                ray_hits[material] = ray_hits[material] + 1
            end
        end
    end

    if print then
        for k,v in pairs(ray_hits) do
            print_dbg("raycast result: %s %s", k,v)
        end
    end

    local final_material = get_highest_value(ray_hits)
    if not final_material then
        -- backup horizontal plus-shaped ray cast
        final_material = ray_cast(vector():set(pos.x + 0.225, pos.y - 0.001, pos.z), vector():set(-1, 0, 0), 0.45, debug).material_name
        if not final_material then
            final_material = ray_cast(vector():set(pos.x, pos.y - 0.001, pos.z + 0.225), vector():set(0, 0, -1), 0.45, debug).material_name
        end
        print_dbg("backup material: %s", final_material)
    end

    return grass_patch and utils.is_actually_grass(final_material) and "materials\\grass"
    or final_material
end

function on_option_change()
    if ui_mcm and oleh_sounds_mcm and oleh_sounds_mcm.on_mcm_load then
        enabled       = ui_mcm.get("oleh_sounds/movement/enabled_jump_sounds")
        volume        = ui_mcm.get("oleh_sounds/movement/volume_jump_sounds") or 0.5
        servo_enabled = ui_mcm.get("oleh_sounds/movement/enabled_servo_sounds")
        servo_volume  = ui_mcm.get("oleh_sounds/movement/volume_servo_sounds") or 0.5
        servo_legacy  = ui_mcm.get("oleh_sounds/movement/legacy_servo_sounds")
        grass_patch   = ui_mcm.get("oleh_sounds/general/grass_patch")
        ice_patch     = ui_mcm.get("oleh_sounds/general/ice_patch")
    elseif ui_mcm and extended_movement_sounds_mcm and extended_movement_sounds_mcm.on_mcm_load then
        enabled       = ui_mcm.get("extended_movement_sounds/enabled_jump_sounds")
        volume        = ui_mcm.get("extended_movement_sounds/volume_jump_sounds") or 0.5
        servo_enabled = ui_mcm.get("extended_movement_sounds/enabled_servo_sounds")
        servo_volume  = ui_mcm.get("extended_movement_sounds/volume_servo_sounds") or 0.5
    end

    exo_jump = servo_legacy and "exo_legacy\\servo_exo_jump_" or "exo\\servo_exo_jump_"
    exo_land = servo_legacy and "exo_legacy\\servo_exo_land_" or "exo\\servo_exo_land_"

    available_materials["materials\\water"] = ice_patch and "concrete_" or "water_"
end

function on_game_start()
assert(oleh_sound_utils and oleh_sound_utils.VERSION and oleh_sound_utils.VERSION >= 5, "\n\n"..
"MovementSFX: oleh_sound_utils.script is missing or outdated, update MSIG (Miscellaneous Sound Improvements) or move it to higher priority\nhttps://github.com/oleh5230/MSIG")

RegisterScriptCallback("actor_on_jump", actor_on_jump)
    RegisterScriptCallback("actor_on_land", actor_on_land)
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("on_option_change", on_option_change)
    RegisterScriptCallback("on_game_load", on_game_load)
	on_option_change()

    --RegisterScriptCallback("actor_on_footstep", actor_on_footstep) -- uncomment to disable footsteps sounds
end

function on_game_load()
	-- Preload SSS sounds
	Footstep_Jump_Snd[0] = sound_object([[material\human\step\rain_jump_01]])
	Footstep_Jump_Snd[1] = sound_object([[material\human\step\rain_jump_02]])
	Footstep_Jump_Snd[2] = sound_object([[material\human\step\rain_jump_03]])

	Footstep_Land_Snd[0] = sound_object([[material\human\step\rain_land_01]])
	Footstep_Land_Snd[1] = sound_object([[material\human\step\rain_land_02]])
	Footstep_Land_Snd[2] = sound_object([[material\human\step\rain_land_03]])
end

function actor_on_footstep(material, power, hud_view, flags)
    flags.ret_value = false
end

function print_dbg(txt, ...)
	if debug then
		printf("[eft_jump_sounds] " .. txt, ...)
	end
end

