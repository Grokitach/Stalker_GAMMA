--// If adding new custom knife, define Tier manually in .ltx as, for example "Tier = 3"

--// Tier Durability & Degradation
--// Tier 1 (0.04) -> Basic knives
--// Tier 2 (0.03) -> Hunting knives
--// Tier 3 (0.02) -> Good quality knives

local strong_monsters = { ["chimera"] = true, ["gigant"] = true, ["giant"] = true }
local sys_ini_file = ini_file("system.ltx")

local active_knife = nil -- We need this to correctly assign degradation if we have multiple knives
local active_variable = nil -- We need this to correctly assign Pelt Quality if we have multiple knives
local active_knife_id = nil -- Lock directly to the unique item ID to prevent loop leaks

local last_sec = nil
local last_var = nil
local ltx_section_cache = {}

--// compat table to prevent crashes from other mods reading the script
knifes = setmetatable({}, {
	__index = function(t, section)
		if not section then return nil end
		if ltx_section_cache[section] ~= nil then
			return ltx_section_cache[section]
		end
		if sys_ini_file:line_exist(section, "kind") and sys_ini_file:r_string(section, "kind") == "w_knife" then
			ltx_section_cache[section] = get_degrade_value(section)
			return ltx_section_cache[section]
		elseif sys_ini_file:line_exist(section, "slot") and sys_ini_file:r_u32(section, "slot") == 11 then
			ltx_section_cache[section] = get_degrade_value(section)
			return ltx_section_cache[section]
		end
		ltx_section_cache[section] = false
		return nil
	end
})

function get_best_hunting_tool()
	if not db.actor then return nil end

	local active_item = db.actor:active_item()
	if active_item and active_item:clsid() == clsid.wpn_knife_s then
		local sec = active_item:section()
		if not string.find(sec, "animation_hit") and not string.find(sec, "axe") and not string.find(sec, "cleaver") then
			active_knife = active_item
			active_variable = sec
			active_knife_id = active_item:id()
			return active_item
		end
	else
		if active_item then
			active_knife = nil active_variable = nil active_knife_id = nil
		elseif active_knife and active_knife:condition() <= 0.15 then
			active_knife = nil active_variable = nil active_knife_id = nil
		end
	end

	if active_knife_id then
		local cached_obj = level.object_by_id(active_knife_id)
		if cached_obj and cached_obj:condition() > 0.01 then
			local c_sec = cached_obj:section()
			if not string.find(c_sec, "axe") and not string.find(c_sec, "cleaver") then
				return cached_obj
			end
		end
		active_knife = nil active_variable = nil active_knife_id = nil
	end

	local chosen_knife = nil
	local highest_tier = -1
	local fallback_knife = nil
	local fallback_highest_tier = -1

	db.actor:iterate_inventory(function(owner, obj)
		if obj:clsid() ~= clsid.wpn_knife_s then return end

		local sec = obj:section()
		if string.find(sec, "animation_hit") or string.find(sec, "axe") or string.find(sec, "cleaver") then
			return
		end

		local tier = get_knife_tier_value(sec)

		if obj:condition() >= 0.15 then
			if tier > highest_tier then
				highest_tier = tier
				chosen_knife = obj
			end
		else
			if tier > fallback_highest_tier then
				fallback_highest_tier = tier
				fallback_knife = obj
			end
		end
	end, db.actor)

	if not chosen_knife then
		chosen_knife = fallback_knife
	end

	return chosen_knife
end

function get_knife_tier_value(section)
	local target_sec = active_variable or section

	local ui_open = level.main_input_receiver and level.main_input_receiver()
	local is_harvesting = active_variable or (ui_open and ui_open:WindowName() == "UIMutantLoot")

	if is_harvesting and ((section ~= last_sec) or (active_variable ~= last_var)) then
		last_sec = section
		last_var = active_variable
	end

	if sys_ini_file:line_exist(target_sec, "tier") then
		return sys_ini_file:r_u32(target_sec, "tier")
	end

	if target_sec == "wpn_knife4" or target_sec == "wpn_knife5" then
		return 2
	elseif target_sec == "wpn_knife6" or target_sec == "wpn_knife7" or target_sec == "wpn_knife8" then
		return 3
	end

	return 1
end

function get_degrade_value(section)
	if not section then return 0.04 end
	local tier = get_knife_tier_value(section)

	if tier == 1 then return 0.04
	elseif tier == 2 then return 0.03
	elseif tier == 3 then return 0.02
	else return 0.02
	end
end

--// function to check if a knife or axe is equipped
function is_equipped()
	local active_item = db.actor and db.actor:active_item()
	if active_item then
		local sec = active_item:section()
		if string.find(sec, "axe") or string.find(sec, "cleaver") then
			return false
		end
	end

	return get_best_hunting_tool() ~= nil
end

--// function to get the condition of the current weapon
function get_condition()
	local obj = get_best_hunting_tool()
	if obj ~= nil then
		return obj:condition()
	end
	return 0
end

--// function to check if the monster can be looted
function can_loot(monster_section)
	if not monster_section then
		return false
	end

	local active_item = db.actor and db.actor:active_item()
	if active_item then
		local sec = active_item:section()
		if string.find(sec, "axe") or string.find(sec, "cleaver") then
			return false
		end
	end

	local obj = get_best_hunting_tool()
	if not obj then return false end

	local wpn_section = obj:section()
	local is_strong = false

	for name, _ in pairs(strong_monsters) do
		if string.find(monster_section, name) then
			is_strong = true
			break
		end
	end

	if is_strong and wpn_section ~= "wpn_knife3" then
		local tier = get_knife_tier_value(wpn_section)
		if tier < 2 then
			return false
		end
	end

	return true
end

--// function to degrade knife condition
function degradate()
	local obj = get_best_hunting_tool()
	if obj ~= nil then
		local cond = obj:condition()
		local num = get_degrade_value(obj:section())

		if cond <= 0.01 then
			active_knife = nil active_variable = nil active_knife_id = nil
			return
		end

		if (cond > num) then
			obj:set_condition(cond - num / 4)
		else
			obj:set_condition(0.01)
		end
	end
	active_knife = nil active_variable = nil active_knife_id = nil
end
