-- oleh5230, 28.10.26

function reset_sprint(shit,bone,flags)
    -- check if hit is from an npc
    if (shit.type == 5 or shit.type == 6) and
    -- check if actor is in sprint state
    bit_and(level.actor_moving_state(), 4096) ~= 0 then
        -- press sprint bind
		level.press_action(bind_to_dik(7))
    end
end

function disable_damage_stagger()
	if db.actor.set_actor_damage_stagger_time_factor then
		db.actor:set_actor_damage_stagger_time_factor(0)
	end
end

function on_game_start()
    RegisterScriptCallback("actor_on_before_hit", reset_sprint)
    RegisterScriptCallback("actor_on_first_update", disable_damage_stagger)
end