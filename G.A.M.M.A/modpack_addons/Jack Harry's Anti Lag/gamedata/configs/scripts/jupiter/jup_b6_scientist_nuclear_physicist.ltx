[logic@jup_b6_scientist_nuclear_physicist]
suitable = {=check_npc_name(jup_b6_scientist_nuclear_physicist)} true, {=check_npc_trader} true
trade = items\trade\trade_ecolog_hermann.ltx
prior = 200
active = beh@spawn_teleport
level_spot = trader
dont_keep_items = true
can_select_weapon = false

[meet@general]
close_snd_hello = jup_b6_scientist_nuclear_physicist_greeting
close_snd_bye = jup_b6_scientist_nuclear_physicist_farewell
close_anim 		= nil
close_victim 	= nil
far_anim 		= nil
far_victim 		= nil
close_distance  = 0
far_distance 	= 0
close_snd_distance = 3
use = {=actor_enemy} false, {=dist_to_actor_le(3)} true, false
snd_on_use = {!dist_to_actor_le(3)} nil
meet_on_talking = false
trade_enable = false

[beh@general]
sound_idle = state
behavior_state = beh_wait
target = waypoint
walk_dist = 100
jog_dist = 220
wait_anim = wait
walk_anim = walk_noweap
jog_anim = walk_noweap
run_noweap = run_noweap
delay_anim = guard
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
meet = meet@general
combat_ignore_cond = {=is_warfare} false, {=actor_true_enemy =check_enemy_name(actor)} false, true
combat_ignore_keep_when_attacked = true
invulnerable = {=is_warfare} false, {!actor_true_enemy} true, false

[beh@spawn_teleport]:beh@general
behavior_state = beh_wait
pt1 = 1000,wait | pos:-227.70300292969,-3.3626835346222,79.456130981445 look:-226.73433458805,-3.3626835346222,79.222807168961
on_timer = 2000 | beh@stand

[beh@stand]:beh@general
behavior_state = beh_wait
pt1 = 86400000,wait | pos:-227.70300292969,-3.3626835346222,79.456130981445 look:-226.73433458805,-3.3626835346222,79.222807168961
path_end = loop
