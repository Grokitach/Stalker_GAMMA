-- Disables random Agroprom Underground transitions on game start
-- oleh5230, 29.03.26
-- Jack_Harris 12.10.26

-- To Do
-- texts edit?

local agr_ug_transitions = {}

local transition_pairs = {
	{
		entrance   = "agr_level_changer_to_underground_2", -- manhole outside institute
		restrictor = "agr_space_restrictor_to_agr_ug_2",
		exit       = "agru_level_changer_to_agroprom_1"
	},
	{
		entrance   = "agr_level_changer_to_underground_3", -- stairway outside factory
		restrictor = "agr_space_restrictor_to_agr_ug_3",
		exit       = "agru_level_changer_to_agroprom_5"
	},
	{
		entrance   = "agr_level_changer_to_underground_4", -- manhole between factory tanks
		restrictor = "agr_space_restrictor_to_agr_ug_4",
		exit       = "agru_level_changer_to_agroprom_4"
	},
	{
		entrance   = "agr_level_changer_to_underground_5", -- institute manhole
		restrictor = "agr_space_restrictor_to_agr_ug_5",
		exit       = "agru_level_changer_to_agroprom_3"
	}
}

function randomize_transitions()
	if has_alife_info("agroprom_underground_transitions_selected") then return end

	local roll = math.random(#transition_pairs)

	agr_ug_transitions.level_changer_list = {}
	agr_ug_transitions.space_restrictor_list = {}
	agr_ug_transitions.level_changer_exit_list = {}

	for i, pair in ipairs(transition_pairs) do
		local state = (i == roll) and "KEEP" or "BLOCK"
		agr_ug_transitions.level_changer_list[pair.entrance] = state
		agr_ug_transitions.space_restrictor_list[pair.restrictor] = state
		agr_ug_transitions.level_changer_exit_list[pair.exit] = state
	end

	for i = 1, 65534 do
		local se_obj = alife_object(i)
		if se_obj and se_obj:name() then
			if se_obj:name() == transition_pairs[roll].restrictor then
				agr_ug_transitions.agr_ug_valid_transition_id = se_obj.id
			elseif se_obj:name() == "agr_space_restrictor_to_agr_ug_1" then
				agr_ug_transitions.agr_ug_backup_transition_id = se_obj.id
			end
		end
	end

	db.actor:give_info_portion("agroprom_underground_transitions_selected")
end

function disable_transitions()
	if not alife_storage_manager.get_state().opened_routes then
		-- printf("[AUGTR] Accessible Zone is OFF. Script is BLOCKED.")
		return
	end

	randomize_transitions()

	if level.name() == "l03_agroprom" and agr_ug_transitions.level_changer_list and agr_ug_transitions.space_restrictor_list then

		-- To keep Map Markers for Transitions OFF - we run this on every single update/load into Agroprom
		for i = 1, 65534 do
			local se_obj = alife_object(i)
			if se_obj and (agr_ug_transitions.level_changer_list[se_obj:name()] == "BLOCK" or agr_ug_transitions.space_restrictor_list[se_obj:name()] == "BLOCK"
			or se_obj:name() == "agr_level_changer_to_underground_6" or se_obj:name() == "agr_space_restrictor_to_agr_ug_6") then

				local spot_types = {"level_changer", "level_changer_up", "level_changer_down"}
				for _, spot in ipairs(spot_types) do
					if level.map_has_object_spot(se_obj.id, spot) ~= 0 then
						level.map_remove_object_spot(se_obj.id, spot)
					end
				end
			end
		end

		-- We flip transitions offline exactly once, first time we run the script
		if not has_alife_info("agroprom_underground_entrances_disabled") then
			db.actor:give_info_portion("agroprom_underground_entrances_disabled")
			for i = 1, 65534 do
				local se_obj = alife_object(i)
				if se_obj and se_obj.online and (agr_ug_transitions.level_changer_list[se_obj:name()] == "BLOCK" or agr_ug_transitions.space_restrictor_list[se_obj:name()] == "BLOCK"
				or se_obj:name() == "agr_level_changer_to_underground_6" or se_obj:name() == "agr_space_restrictor_to_agr_ug_6") then
					alife():set_switch_online(se_obj.id, false)
					alife():set_switch_offline(se_obj.id, true)
					se_obj:switch_offline()
				end
			end
		end

	elseif not has_alife_info("agroprom_underground_anomaly_released") and level.name() == "l03u_agr_underground" then

		db.actor:give_info_portion("agroprom_underground_anomaly_released")
		for i = 1, 65534 do
			local se_obj = alife_object(i)
			if se_obj and se_obj:name() == "kat2_zone_buzz_0015" then
				safe_release_manager.release(se_obj)
			end
		end
	end

	--[[
	elseif not has_alife_info("agroprom_underground_exits_disabled") and level.name() == "l03u_agr_underground" then

		printf("[agroprom_underground_transition_randomizer] Initialization...")
		for i = 1, 65534 do
			local se_obj = alife_object(i)
			if se_obj and se_obj.online and agr_ug_transitions.level_changer_exit_list[se_obj:name()] then
				printf("[agroprom_underground_transition_randomizer] Setting offline: %s, %s", se_obj:name(), se_obj.id)
				alife():set_switch_online(se_obj.id, false)
				alife():set_switch_offline(se_obj.id, true)
				se_obj:switch_offline()
				printf("[agroprom_underground_transition_randomizer] object ID %s online status: %s", se_obj.id, se_obj.online)
			end
		end
		db.actor:give_info_portion("agroprom_underground_exits_disabled")
	]]
end

task_functor.valid_agr_ug_transition = function(task_id,field,p,tsk)
	if not alife_storage_manager.get_state().opened_routes then
		return nil
	end
	--printf("[agroprom_underground_transition_randomizer] Task target: %s %s", target and target:name(), target.id)
	return agr_ug_transitions.agr_ug_valid_transition_id or agr_ug_transitions.agr_ug_backup_transition_id or nil
end

function save_state(m_data)
	m_data.agr_ug_transitions = agr_ug_transitions
end

function load_state(m_data)
	agr_ug_transitions = m_data.agr_ug_transitions or {}
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", disable_transitions)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
end
