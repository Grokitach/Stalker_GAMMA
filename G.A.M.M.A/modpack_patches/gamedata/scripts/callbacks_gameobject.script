-- Monster combat action decision callback, fired at the head of the shared monster attack selectors.
-- A subscriber sets flags.substate to a monster_state.* id (e.g. monster_state.eStateAttack_RunAway);
-- the engine selects it only if its own
-- start conditions pass, else the vanilla selection runs. Left at -1 = no proposal = exact vanilla.
-- A proposed substate's check_start_conditions runs every selector tick (camp runs a cover search),
-- and the selector crosses into this relay once per tick even with zero subscribers.
AddScriptCallback("monster_on_combat_action")
_G.CMonsterCombatAction = function(monster, enemy, dist, enemy_strength, can_jump)
	local flags = { substate = -1 }
	SendScriptCallback("monster_on_combat_action", monster, enemy, dist, enemy_strength, can_jump, flags)
	return tonumber(flags.substate) or -1
end

--[[ 

On right click on PDA map callback
Params are property_ui and map_table
property_ui is the same as in pda.property_box_add_properties callback
map_table contains:
	level_name - name of hovered map
	pos - position in the real world under the cursor on the hovered map
	global_map_pos - position under the cursor on the global map canvas, not the real world position
	object_id - id of object under cursor, 65535 if no object
	hint - tooltip string for the object under cursor, nil if no object
	lvid - level vertex id by position on the hovered map
	gvid - game vertex id by position on the hovered map

--]]

-- Replace base pda.property_box_clicked so the clicked item's u32 TAG is forwarded
-- as a trailing prop_id arg, letting menus carry duplicate labels.
function pda.property_box_clicked(property_ui)
	local list_item = property_ui:GetSelectedItem()
	if not (list_item) then
		return
	end
	local prop = list_item:GetTextItem():GetText()
	SendScriptCallback("map_spot_menu_property_clicked", property_ui,
		pda.map_spot_property.id, pda.map_spot_property.level_name, prop, list_item:GetTAG())
end

AddScriptCallback("on_map_right_click")
_G.COnRightClickMap = function(property_ui, map_table)
	pda.map_spot_property.id = map_table.object_id
	pda.map_spot_property.level_name = map_table.level_name
	SendScriptCallback("on_map_right_click", property_ui, map_table)
end

-- Engine sets the clicked menu item's owning spot before pda.property_box_clicked,
-- so a merged multi-object context menu dispatches the correct object id per item.
function pda.set_map_spot_context(id, level_name)
	pda.map_spot_property.id = id
	pda.map_spot_property.level_name = level_name
end

--[[

On left click on PDA map spot callback
Params are id, level_name, spot_type
	id - alife object id of the spot, 65535 if none
	level_name - name of the level the spot belongs to
	spot_type - icon id from map_spots XML

--]]

AddScriptCallback("on_map_spot_selected")
function pda.map_spot_selected(id, level_name, spot_type)
	SendScriptCallback("on_map_spot_selected", id, level_name, spot_type)
end

