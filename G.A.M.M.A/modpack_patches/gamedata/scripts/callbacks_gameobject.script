-- Add on_item_take/drop callbacks for Sidorovich/Forester
AddScriptCallback("sid_forester_on_item_take")
AddScriptCallback("sid_forester_on_item_drop")
function bind_trader.trader_object_binder:on_item_take(item)
	SendScriptCallback("sid_forester_on_item_take", self.object, item)
end
function bind_trader.trader_object_binder:on_item_drop(item)
	SendScriptCallback("sid_forester_on_item_drop", self.object, item)
end

bind_trader_trader_object_binder_reinit = bind_trader.trader_object_binder.reinit
bind_trader.trader_object_binder.reinit = function(self)
	bind_trader_trader_object_binder_reinit(self)
	self.object:set_callback(callback.on_item_take, self.on_item_take, self)
	self.object:set_callback(callback.on_item_drop, self.on_item_drop, self)
end
bind_trader_trader_object_binder_net_destroy = bind_trader.trader_object_binder.net_destroy
bind_trader.trader_object_binder.net_destroy = function(self)
	self.object:set_callback(callback.on_item_take, nil)
	self.object:set_callback(callback.on_item_drop, nil)
	bind_trader_trader_object_binder_net_destroy(self)
end

-- actor_on_task_callback
AddScriptCallback("actor_on_task_callback")
task_callback = task_manager.task_callback
task_manager.task_callback = function(tsk, state)
	local tm = task_manager.get_task_manager()
	local id = tsk:get_id()
	SendScriptCallback("actor_on_task_callback", tsk, state, tm, id)
	task_callback(tsk, state)
end

