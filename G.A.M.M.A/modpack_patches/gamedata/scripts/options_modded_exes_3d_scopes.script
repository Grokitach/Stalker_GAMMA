--- Shader scopes options tree

-- Import smart constructors
options_builder.import_into(this)

-- Shader scopes
PAGE = page {
	{ id = "3d_scopes" },
			
	list_bool { id = "r__3Dfakescope", def = "0" },
	list_bool { id = "interpolation_based_scope_zoom", def = "0" },

	slide { id = "2d_scopes" },
	check {
		id = "sds_enable",
		def = true
	},
	check {
		id = "sds_speed_enable",
		def = true
	},
	check {
		id = "sds_zoom_enable",
		def = true
	},
	check {
		id = "new_zoom_enable",
		def = false
	},
	list_bool { id = "new_zoom_delta_algorithm", def = "0" },
	track {
		id = "zoom_step_count",
		def = 3,
		step = 1,
	},
	track {
		id = "scope_blur_inner",
		def = 0.1,
		step = 0.05,
	},
	track {
		id = "scope_blur_outer",
		def = 1,
		min = 0,
		max = 1,
		step = 0.05,
	},
	track {
		id = "scope_brightness",
		def = 1,
		step = 0.05,
	},
	track {
		id = "scope_ca",
		def = 0.003,
		min = 0,
		max = 0.01,
		step = 0.0005,
	},
					
	line {},
					
	track {
		id = "scope_fog_radius",
		def = 1.25,
		min = 0.5,
		max = 1.5,
		step = 0.05,
	},
	track {
		id = "scope_fog_interp",
		def = 0.15,
		min = 0.05,
		max = 0.25,
		step = 0.01,
	},
	track {
		id = "scope_fog_sharp",
		def = 4,
		min = 2,
		max = 20,
		step = 1,
	},
	track {
		id = "scope_fog_swayAim",
		def = 0.66,
		min = 0,
		max = 5,
		step = 0.01,
	},
	track {
		id = "scope_fog_swayMove",
		def = 0.25,
		min = 0,
		max = 3,
		step = 0.01,
	},
	track {
		id = "scope_fog_travel",
		def = 0.25,
		min = 0.2,
		max = 2,
		step = 0.05,
	},

	line {},

	-- Keep the vector last so all four controls are returned into the page.
	(function()
		if not get_console_cmd(0, "reflex_param") then return false end
		return vector {
			id = "reflex_param",
			x_min = 0, x_max = 1000, x_def = 0, x_step = 0.1,
			y_min = 0, y_max = 1000, y_def = 0, y_step = 0.1,
			z_min = 0, z_max = 1000, z_def = 0, z_step = 0.1,
			w_min = 0, w_max = 1000, w_def = 0, w_step = 0.1,
			path = "visual/3d_scopes",
		}
	end)(),
}
