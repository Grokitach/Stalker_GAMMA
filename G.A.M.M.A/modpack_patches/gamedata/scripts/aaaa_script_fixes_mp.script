-- xrs_facer faulty hit_callback
function xrs_facer.hit_callback(obj, amount, dir, who, bone_index)
	if not xrs_facer.Enabled then return end
	if bone_index == "from_death_callback" then return end
	if not db.storage[obj:id()].facer then return end

	if who and (IsStalker(who) or IsMonster(who)) and who:alive() and xrs_facer.check_enemy(who, obj) then
		local target_id = load_var(obj, "facer_target", nil)
		local target = target_id and db.storage[target_id] and db.storage[target_id].object
		if
			not target
			or obj:relation(target) ~= game_object.enemy
			or target:position():distance_to_sqr(obj:position()) > 4
		then
			save_var(obj, "facer_target", who:id())
			db.storage[obj:id()].facer.check_time = time_global() + xrs_facer.facer_sets.check_prd
		end
	end
end

-- axr_trade_manager npc trading fixes
function axr_trade_manager.npc_trade_buy_sell(npc)
	local id = npc and npc:id()
	local st = id and db.storage[id]
	if not (st) then
		return
	end

	if not (st.has_items_to_sell) then
		--printf("st.has_items_to_sell = nil!")
		return
	end

	if not (st.trade_items) then
		--printf("no items to sell")
		return
	end

	local smart = xr_gulag.get_npc_smart(npc)
	local npc_info = smart and smart.npc_info[id]
	if (npc_info) then
		npc_info.job.idle = time_global() + 20000
	end

	printf("- NPC Trade | Selling")

	local se_obj = alife_object(id)
	if not (se_obj) then
		return
	end

	-- Get the Trader
	local smart = xr_gulag.get_npc_smart(npc)
	local npc_info = smart and smart.npc_info[id]
	local seller_id = npc_info and npc_info.job and npc_info.job.seller_id
	local seller = seller_id and (db.storage[seller_id] and db.storage[seller_id].object or level.object_by_id(seller_id))
	printf("- NPC Trade | Trader = %s", seller and seller:name())
	
	-- SELL ITEMS
	local itm,itm_base_cost,buy_sell, slot, bw,can_sell
	for sec,count in pairs(st.trade_items) do
		-- demonized: fixed count loop to go down
		local count = tonumber(count) or 0
		for i=count, 1, -1 do
			itm = npc:object(sec)
			if (itm) then
				can_sell = true

				-- Make sure item is not his best weapon
				bw = npc:best_weapon()
				if (bw and bw:id() == itm:id()) then
					can_sell = false
				end

				-- Make sure item is not equipped
				for i=1,12 do
					slot = npc:item_in_slot(i)
					if (slot and slot:id() == itm:id()) then
						can_sell = false
						break
					end
				end

				buy_sell = axr_trade_manager.ini:r_string_ex("buy_sell",sec)
				if (buy_sell and buy_sell ~= "" and can_sell) then
					buy_sell = str_explode(buy_sell,",")
					
					-- Transfer the item
					if seller then
						npc:transfer_item(itm, seller)
					else
						alife_release_id(itm:id())
					end

					-- Give money
					itm_base_cost = ini_sys:r_float_ex(sec,"cost") or 30
					local money = math.floor(itm_base_cost * (tonumber(buy_sell[4]) or 1))
					npc:give_money(money)
					
					-- Increase NPC rank because he is a good boy
					game_statistics.increment_npc_statistic(npc,"items_sold")
					
					printf("- NPC Trade | %s sold [%s] for %s RU", npc:name(), sec, money)

					-- Only sell enough till reach keep-in-stock count (param 1)
					if (i <= tonumber(buy_sell[1])) then
						break
					end
				end
			end
		end
	end
	
	empty_table(st.trade_items)
	st.has_items_to_sell = false

	-- BUY ITEMS
	local money = npc:money()
	if (money == nil or money <= 0) then
		return
	end

	if not (smart) then
		return
	end

	if (npc_info == nil or npc_info.job == nil) then
		return
	end

	if not (seller) then
		return
	end

	printf("- NPC Trade | Buying")

	local valid_items = utils_data.collect_section(axr_trade_manager.ini,"buy_sell",true)
	local item_list = {}

	local count = 0
	local function itr(npc,itm)
		local sec = itm:section()
		if (sec and valid_items[sec]) then
			-- count all valid items NPC has matching the buy_sell list
			item_list[sec] = item_list[sec] and item_list[sec] + 1 or 1
		end
	end

	npc:iterate_inventory(itr,npc)

	local bw = npc:best_weapon()
	bw = bw and bw:section()

	local bw_ammos = bw and parse_list(ini_sys,bw,"ammo_class",true)
	local buy_sell_items = {}
	local size_t = 0
	local buy_sell,total_cost
	for sec,v in pairs(valid_items) do
		buy_sell = axr_trade_manager.ini:r_string_ex("buy_sell",sec)
		if (buy_sell and buy_sell ~= "") then
			buy_sell = str_explode(buy_sell,",")

			itm_base_cost = ini_sys:r_float_ex(sec,"cost") or 30
			total_cost = math.floor(itm_base_cost * (tonumber(buy_sell[5]) or 1))

			-- If section is ammo, only buy ammo for best weapon
			if IsItem("ammo",sec) or (bw_ammos and bw_ammos[sec]) then
				if (item_list[sec]) then
					-- only buy enough to reach restock goals (param 3)
					for i=item_list[sec],tonumber(buy_sell[3]) do
						if (money >= total_cost) then
							size_t = size_t + 1
							buy_sell_items[size_t] = sec
							alife_create_item(sec, npc)
							npc:transfer_money(total_cost,seller)
							printf("- NPC Trade | %s bought [%s] for %s RU", npc:name(), sec, total_cost)
							money = money - total_cost
						end
					end
				else
					-- only buy enough to reach restock goals (param 3)
					for i=1,tonumber(buy_sell[3]) do
						if (money >= total_cost) then
							size_t = size_t + 1
							buy_sell_items[size_t] = sec
							alife_create_item(sec, npc)
							npc:transfer_money(total_cost,seller)
							printf("- NPC Trade | %s bought [%s] for %s RU", npc:name(), sec, total_cost)
							money = money - total_cost
						end
					end
				end
			end
		end

		-- NPC ran out of money, end loop
		if (money <= 0) then
			break
		end
	end
	
	if (#buy_sell_items > 0) then 
		if (dynamic_news_manager and ui_options.get("alife/dynamic_news/nearby_activity_news")) then 
			dynamic_news_manager.get_dynamic_news():BoughtItems(npc,seller,buy_sell_items)
		end
	end
end

function axr_trade_manager.npc_tech_upgrade_sell(npc)
	local id = npc and npc:id()
	local st = id and db.storage[id]
	if not (st) then
		return
	end

	if not (st.has_tech_items) then
		--printf("st.has_tech_items = nil!")
		return
	end

	if not (st.tech_items) then
		--printf("no tech items to sell")
		return
	end

	local smart = xr_gulag.get_npc_smart(npc)
	local npc_info = smart and smart.npc_info[id]
	if (npc_info) then
		npc_info.job.idle = time_global() + 20000
	end

	printf("- NPC Tech | Selling")

	local se_obj = alife_object(id)
	if not (se_obj) then 
		return 
	end
	
	-- Get the Trader
	local smart = xr_gulag.get_npc_smart(npc)
	local npc_info = smart and smart.npc_info[id]
	local mechanic_id = npc_info and npc_info.job and npc_info.job.mechanic_id
	local mechanic = mechanic_id and (db.storage[mechanic_id] and db.storage[mechanic_id].object or level.object_by_id(mechanic_id))
	printf("- NPC Tech | Mechanic = %s", mechanic and mechanic:name())
	
	-- SELL ITEMS
	local itm,itm_base_cost,buy_sell, slot, bw,can_sell
	for sec,count in pairs(st.tech_items) do
		-- demonized: fixed count loop to go down
		local count = tonumber(count) or 0
		for i=count, 1, -1 do
			itm = npc:object(sec)
			if (itm) then
				can_sell = true

				-- Make sure item is not his best weapon
				bw = npc:best_weapon()
				if (bw and bw:id() == itm:id()) then
					can_sell = false
				end

				-- Make sure item is not equipped
				for i=1,12 do
					slot = npc:item_in_slot(i)
					if (slot and slot:id() == itm:id()) then
						can_sell = false
						break
					end
				end

				buy_sell = axr_trade_manager.ini:r_string_ex("buy_sell_mechanic",sec)
				if (buy_sell and buy_sell ~= "" and can_sell) then
					buy_sell = str_explode(buy_sell,",")
					
					-- Transfer the item
					if mechanic then
						npc:transfer_item(itm, mechanic)
					else
						alife_release_id(itm:id())
					end

					-- Give money
					itm_base_cost = ini_sys:r_float_ex(sec,"cost") or 30
					local money = math.floor(itm_base_cost * (tonumber(buy_sell[4]) or 1))
					npc:give_money(money)
					
					-- Increase NPC rank because he is a good boy
					game_statistics.increment_npc_statistic(npc,"items_sold")
					
					printf("- NPC Tech | %s sold [%s] for %s RU", npc:name(), sec, money)

					-- Only sell enough till reach keep-in-stock count (param 1)
					if (i <= tonumber(buy_sell[1])) then
						break
					end
				end
			else
				printf("! NPC Tech | no item [%s] found for npc %s", sec, npc:name())
			end
		end
	end
	
	empty_table(st.tech_items)
	st.has_tech_items = false

	-- Upgrade
	local money = npc:money()
	if (money == nil or money <= 0) then
		return
	end

	if not (smart) then
		return
	end

	if (npc_info == nil or npc_info.job == nil) then
		return
	end

	if not (mechanic) then
		return
	end
	
	local wpn = npc:best_weapon()
	if not (wpn and IsWeapon(wpn) and not IsMelee(wpn)) then
		return
	end
	
	local sec_wpn = wpn:section()
	printf("- NPC Tech | Upgrading weapons [%s]", sec_wpn)
	
	-- Upgrades calculating
	local picked = {}
	local upgrades = utils_item.get_upgrades_tree(sec_wpn)
	if not (upgrades and size_table(upgrades) > 0) then
		printf("warning: axr_trade_manager.npc_tech_upgrade_sell(): no upgrades found for [%s]", sec_wpn)
		return
	end
	local installed = utils_item.get_upgrades_installed(wpn, nil, true)
	
	local opposite = {
			[1] = 2,
			[2] = 1,
			[3] = 4,
			[4] = 3,
			[5] = 6,
			[6] = 5,
	}
	local money_before = money
	local functor = function(t,a,b) return a < b end
	local cnt = 0
	
	for gr,v in spairs(upgrades,functor) do
		for ind,v2 in spairs(v,functor) do
			if installed[v2.section] then
				axr_trade_manager.picked_set(picked, gr, ind)
			end
		end
	end
	
	while (cnt < axr_trade_manager.max_upgrades_per_visit) and (money > 500) do
		local gr = random_key_table(upgrades)
		for ind, v in spairs(upgrades[gr],functor) do
			local section = v.section
			local cost = v.stats_cost or 2000
			
			if upgrades[gr][ind].prop
			and (upgrades[gr][ind].prop[1] ~= "prop_not_available")
			and axr_trade_manager.picked_unchecked(picked, gr, ind)
			and (not installed[section])
			then
				if (not upgrades[gr][opposite[ind]])
				or (upgrades[gr][opposite[ind]] and axr_trade_manager.picked_unchecked(picked, gr, opposite[ind]))
				then
					axr_trade_manager.picked_set(picked, gr, ind)
					money = money - cost
					printf("/ NPC Tech | %s installed upgrade [%s] for %s RU", npc:name(), section, cost)
					break
				end
			end
		end
		cnt = cnt + 1
	end
	money = money > 100 and money or math.random(100,200)
	
	local to_install = {}
	local new_install = {}
	for gr,v in spairs(upgrades,functor) do
		for ind,v2 in spairs(v,functor) do
			if (picked[gr] and picked[gr][ind]) then
				to_install[#to_install + 1] = v2.section
				new_install[#new_install + 1] = v2.section
				printf("- NPC Tech | upgrade [%s] is new", v2.section)
			elseif installed[v2.section] then
				to_install[#to_install + 1] = v2.section
				printf("~ NPC Tech | upgrade [%s] is old", v2.section)
			end
		end
	end
	
	if (#to_install <= #installed) then
		printf("! NPC Tech | no new upgrades are picked")
		return
	end
	
	-- Consume NPC money
	npc:give_money(money - money_before)
	printf("/ NPC Tech | money taken: %s", money - money_before)
	
	-- Install upgrades
	inventory_upgrades.force_upgrade = true
	for i=1,#new_install do
		wpn:install_upgrade(new_install[i])
	end
	inventory_upgrades.force_upgrade = false

	
	-- Send news
	if (#new_install > 0) then 
		if (dynamic_news_manager and ui_options.get("alife/dynamic_news/nearby_activity_news")) then
			dynamic_news_manager.get_dynamic_news():UpgradedItems(npc, mechanic, sec_wpn, new_install)
		end
	end
end

-- Fix for returning wrong attached scope
utils_item.has_scope = function(section)
	if not utils_item.scopes_list then
		utils_item.scopes_list = utils_data.collect_section(ini_sys, "addons_table")
	end

	local function sort_func(t, a, b)
		if #t[a] ~= #t[b] then 
			return sort_func_values_length_descend(t, a, b) 
		else
			return sort_func_values_descend(t, a, b)
		end
	end
	
	-- Determine which addon is attached to the weapon.
	-- demonized: Sort addons by descend and check if the weapon section ends with addon section instead of string.find
	for k, v in spairs(utils_item.scopes_list, sort_func) do
		if section:endswith(v) then
			return v
		end
	end
end

-- Fix broken location_types table in sim_squad_scripted
-- The original builds: location_types[mask_string] = mask_string  (e.g. ["255,255,255,000"] = "255,255,255,000")
-- But set_location_types_section() looks up by section name  (e.g. location_types["stalker_terrain"])
-- Unlocalized via unlocalizer_modded_exes_sim_squad_scripted.ltx, repopulated here
do
	local lt = sim_squad_scripted.location_types
	if lt then
	    empty_table(lt)
		local locations_ini = ini_file("misc\\smart_terrain_masks.ltx")
		locations_ini:section_for_each(function(section)
			local a, key, val = locations_ini:r_line_ex(section, 0, "", "")
			lt[section] = key
			return false
		end)
	end
end

-- Don't update member-less squads pending release: avoids sim:object(commander_id()==0xffff) spam
do
	local sq = sim_squad_scripted.sim_squad_scripted
	local orig_generic_update = sq.generic_update
	function sq.generic_update(self, ...)
		if self:npc_count() == 0 then
			return
		end
		return orig_generic_update(self, ...)
	end
end

-- Fix for returning wrong scope section on detaching
function item_weapon.detach_scope(weapon)
	-- Return if the weapon is not valid.
	if not weapon then
		return
	end
	
	-- An addon has not been attached or none can be detached.
	local parent_section = ini_sys:r_string_ex(weapon:section(),"parent_section")
	if not parent_section or weapon:section() == parent_section then
		return
	end
	
	-- Get weapon owner
	local old_weapon = alife_object(weapon:id())
	local owner = old_weapon and old_weapon.parent_id and get_object_by_id(old_weapon.parent_id)
	if not owner then
		printf("~ item_weapon.detach_scope | weapon owner not found")
		return
	end

	local function sort_func(t, a, b)
		if #a ~= #b then 
			return sort_func_keys_length_descend(t, a, b) 
		else
			return sort_func_keys_descend(t, a, b)
		end
	end
	
	-- Determine which addon is attached to the weapon.
	-- Create the item in the actor's inventory when found.
	-- demonized: Sort addons by descend and check if the weapon section ends with addon section instead of string.find
	for k, v in spairs(item_weapon.scopes_table, sort_func) do
		if weapon:section():endswith(k) then
			alife_create_item(k, owner)
			break
		end
	end
	
	-- Create objects for the 'before' and 'after' detachment weapons.
	if old_weapon then
		alife_clone_weapon(old_weapon, parent_section)
	end
end

-- Allow adding "scopes" field via upgrades
local item_weapon_attach_scope_weapon
local item_weapon_attach_scope_item
item_weapon_attach_scope = item_weapon.attach_scope
item_weapon.attach_scope = function(item, weapon, ...)
	item_weapon_attach_scope_item = item
	item_weapon_attach_scope_weapon = weapon
	item_weapon_attach_scope(item, weapon, ...)
	item_weapon_attach_scope_item = nil
	item_weapon_attach_scope_weapon = nil
end
item_weapon_on_item_drag_dropped = item_weapon.on_item_drag_dropped
item_weapon.on_item_drag_dropped = function(obj_1, obj_2, ...)
	item_weapon_attach_scope_item = obj_1
	item_weapon_attach_scope_weapon = obj_2
	item_weapon_on_item_drag_dropped(obj_1, obj_2, ...)
	item_weapon_attach_scope_item = nil
	item_weapon_attach_scope_weapon = nil
end

function get_scopes_from_upgrade(upgr_sec, weapon)
	local sec = SYS_GetParam(0, upgr_sec, "section")
	if not sec then return {} end

	local scopes = SYS_GetParam(0, sec, "scopes")
	if not scopes then return {} end

	return str_explode(scopes, ",")
end 

item_weapon_check_scope = item_weapon.check_scope
item_weapon.check_scope = function(addon_sect, weapon_sect, ...)
	if item_weapon_check_scope(addon_sect, weapon_sect, ...) then
		return true
	end

	local item = item_weapon_attach_scope_item
	local weapon = item_weapon_attach_scope_weapon

	if not (item and weapon) then
		return false
	end

	local found = false
	weapon:iterate_installed_upgrades(function(upgr_sec)
		for i, v in ipairs(get_scopes_from_upgrade(upgr_sec, weapon)) do
			if v == addon_sect then
				found = true
				return true
			end
		end
	end)

	return found
end

-- Highlighting for scopes that were added
function ActorMenu_on_item_focus_receive(obj)
	local sec_focus = obj:section()
	local focus_tbl = {}

	-- For weapons
	if IsWeapon(obj) then
		
		-- Scopes
		obj:iterate_installed_upgrades(function(upgr_sec)
			for i, v in ipairs(get_scopes_from_upgrade(upgr_sec, obj)) do
				focus_tbl[#focus_tbl + 1] = v
			end
		end)
	end
	local inventory = GetActorMenu()
	if not ((#focus_tbl > 0) or (inventory and inventory:IsShown())) then
		return
	end
	
	for i=1,#focus_tbl do 
		inventory:highlight_section_in_slot(focus_tbl[i],EDDListType.iActorBag)
		inventory:highlight_section_in_slot(focus_tbl[i],EDDListType.iPartnerTradeBag)
		inventory:highlight_section_in_slot(focus_tbl[i],EDDListType.iDeadBodyBag)
		inventory:highlight_section_in_slot(focus_tbl[i],EDDListType.iActorTrade)
		inventory:highlight_section_in_slot(focus_tbl[i],EDDListType.iPartnerTrade)
	end
end

-- Fixed 65534 loop in this
-- Make npcs not blind when they got hit
local transparent_gg_ignore_id = {}
function trans_outfit.transparent_gg()
	if not trans_outfit.ReadOutfitBlindnessKoeff then return end

	local range1 
	local outfit_in_slot = db.actor:item_in_slot(7)

	if not outfit_in_slot then 
		range1 = 80  
	elseif trans_outfit.ReadOutfitBlindnessKoeff(outfit_in_slot:section()) > 0.0 then
		range1 = trans_outfit.ReadOutfitBlindnessKoeff(outfit_in_slot:section())
	else 
		range1 = 80 
	end

	local is_blind = range1 < 80

	for i = 1, #db.OnlineStalkers do
		local id = db.OnlineStalkers[i]
		local obj_around = gameobjects_registry[id]
		if obj_around and IsStalker(obj_around) and id ~= AC_ID then
			local dist_act_npc = db.actor:position():distance_to_sqr(obj_around:position())
			local is_ignore = not is_blind and transparent_gg_ignore_id[id] and transparent_gg_ignore_id[id].stop_ignore_time > time_global()
			if is_ignore then
				obj_around:set_range(math.max(200, range1))
			elseif dist_act_npc <= math.max(range1^2, is_blind and 120^2 or 100^2) then  
				obj_around:set_range(range1)
			else 
				obj_around:set_range(80) 
			end 
		end 
	end
end

function transparent_gg_add_to_ignore_ids(npc, amount, local_direction, who, bone_index)
	transparent_gg_ignore_id[npc:id()] = {
		stop_ignore_time = time_global() + 120 * 1000
	}
end

-- Lander:
-- Implement missing `CSE_ALifeSmartZone::task()` bind.
-- Fixes segfault inside `CALifeMonsterBrain::process_task`,
-- which was preventing offline monsters (+ stalkers) from pathfinding.
function smart_terrain.se_smart_terrain:task()
	return self.smart_alife_task
end

-- Remove stutter when raising PDA by iterating actual se_stalker and se_monster objects instead of whole alife
if pda.coc_ranking_list then
	function pda.calculate_rankings()
		local t = {}
		local sim = alife()

		-- add actor to list
		t[0] = sim:actor():rank()
		
		-- check all stalker server objects
		for i, _ in pairs(db.offline_objects) do
			if i ~= 65535 then
				local se_obj = sim:object(i)
				if (se_obj and IsStalker(nil,se_obj:clsid()) and se_obj:alive() and se_obj:community() ~= "zombied" and se_obj:community() ~= "trader") then
					-- Check if object has a story id, if it does they are probably unique
					local sid = story_objects.story_id_by_object_id[se_obj.id]
					if not (sid) then
						t[se_obj.id] = se_obj:rank()
					end
				end
			end
		end
		
		local size_t = 0
		local coc_ranking_list = pda.coc_ranking_list
		local coc_ranking_array_size = pda.coc_ranking_array_size or 100

		-- sort by highest rank first
		for id, rank in spairs(t, sort_func_values_descend) do
			size_t = size_t + 1
			coc_ranking_list[size_t] = id
			if (id == AC_ID) then
				pda.actor_rank_place = size_t
			end
		end
		-- Trim excessive data
		for i = coc_ranking_array_size, size_t + 1, -1 do
			coc_ranking_list[i] = nil
		end
		
		-- force actor into last visible slot + 1 on ranking list
		coc_ranking_list[coc_ranking_array_size+1] = 0
	end
end

-- Saloeater: Fix/trade manager resupply sync
local old_trade_manager_trade_init = trade_manager.trade_init
function trade_manager.trade_init(npc, cfg)
	if not (db.actor) then 
		return 
	end 

    local id = npc:id()
    local reup_time = trade_manager.get_trade_profile(id, "resupply_time")
    old_trade_manager_trade_init(npc, cfg)
    if not reup_time then return end

    local trade_profile = trade_manager.get_trade_profile(id)
    if not trade_profile then return end
    
    trade_profile.resupply_time = reup_time
end

-- Prefetch HUD visual when moving item to slot
function actor_item_to_slot_prefetch(item)
	local hudSec = SYS_GetParam(0, item:section(), "hud")
	if hudSec then
		local visual = SYS_GetParam(0, hudSec, "item_visual")
		if visual then
			game.prefetch_model(visual)
		end
	end
end

-- Prefetch current items
function actor_on_first_update_prefetch()
	db.actor:iterate_inventory(function(npc, item)
		local ui_texture = SYS_GetParam(0, item:section(), "icons_texture", "ui\\ui_icon_equipment")
		game.prefetch_texture(ui_texture)

		if item_backpack.is_in_slot(item) then
			local hudSec = SYS_GetParam(0, item:section(), "hud")
			if hudSec then
				local visual = SYS_GetParam(0, hudSec, "item_visual")
				if visual then
					game.prefetch_model(visual)
				end
			end
		end
	end, db.actor)
end

-- Update ranks on first update
function actor_on_first_update_calculate_rankings()
	pda.calculate_rankings()
end

-- Force update close enough traders
local function t2c(t)
	if not t then return nil end
	local ct = game.CTime()
	ct:set(t.Y,t.M,t.D,t.h,t.m,t.s,t.ms)
	return ct
end

function npc_on_update_force_trader_update(npc)
	if npc:position():distance_to_sqr(db.actor:position()) < 30^2 then
		-- Copy checks from trade_manager with fixed restock time, fixes GAMMA
		local id = npc:id()
		local tm = trade_manager.get_trade_profile(id)
		if not tm then
			return
		end
		
		if not tm.cfg_ltx then 
			return
		end 
		
		local config = trade_manager.get_trade_cfg(tm.cfg_ltx)
		if not config then
			return
		end

		local restock_time = math.max(game_difficulties.get_eco_factor("restock") or 24, 12)
		if (tm.resupply_time and game.get_game_time():diffSec(t2c(tm.resupply_time)) < (restock_time * 3600))  then
			return
		end

		trade_manager.update(npc)
	end
end

-- Improve NPCs pathfinding by reducing actual anomaly damage radius
-- Works only when npc:get_enable_anomalies_pathfinding() == true or ai_die_in_anomalies cvar is 1
function is_outside_damage_radius(zone, obj)
	local se_zone = alife_object(zone:id())
	if not se_zone then
		return false
	end

	local data = utils_stpk.get_anom_zone_data(se_zone)
	if not (data and data.shapes[1] and data.shapes[1].radius) then
		return false
	end

	local radius = data.shapes[1].radius
	local damage_radius = math.max(radius - 1.1, 1)
	local damage_radius_sqr = damage_radius * damage_radius
	local dist_sqr = zone:position():distance_to_sqr(obj:position())
	local res = dist_sqr > damage_radius_sqr
	return res
end

function anomaly_on_before_activate_pathfinding(zone, obj, flags)
	if obj:id() ~= AC_ID 
	and (IsStalker(obj) or IsMonster(obj))
	and obj:alive()
	and is_outside_damage_radius(zone, obj)
	then
		flags.ret_value = false
	end
end

-- Pathfinding to evade anomalies by dynamically registering anomalies' SR
-- Enabled only for monsters, might be stuttery
local anomaly_restrictor_db = {}
local anomaly_restrictor_db_k
local anomaly_restrictor_db_v
local anomaly_restrictor_db_by_gvid = {}
function anomaly_add_to_db(obj)
	local anomaly_classes = {
		[clsid.zone_rusty_hair]		= true,
		[clsid.zone_bfuzz]			= true,
		[clsid.zone_bfuzz_s]		= true,
		[clsid.zone_mosquito_bald]	= true,
		[clsid.zone_mbald_s]		= true,
		[clsid.zone_galantine]		= true,
		[clsid.zone_galant_s]		= true,
		[clsid.zone_mincer]			= true,
		[clsid.zone_mincer_s]		= true,
	}
	if not anomaly_classes[obj:clsid()] then
		return
	end

	local se_zone = alife_object(obj:id())
	if not se_zone then
		return
	end

	local data = utils_stpk.get_anom_zone_data(se_zone)
	if not (data and data.shapes[1] and data.shapes[1].radius) then
		return
	end

	local radius = data.shapes[1].radius
	anomaly_restrictor_db[obj:id()] = {
		radius = radius + 20,
		entities = {},
		last_pos = VEC_ZERO
	}
	anomaly_restrictor_db_by_gvid[obj:game_vertex_id()] = anomaly_restrictor_db_by_gvid[obj:game_vertex_id()] or {}
	anomaly_restrictor_db_by_gvid[obj:game_vertex_id()][obj:id()] = {
		entities = {}
	}
end

-- Active online monsters registry to bypass expensive engine spatial queries
local db_online_monsters = {}

function track_monsters_on_spawn(obj)
	if IsMonster(obj) then
		db_online_monsters[obj:id()] = obj
	end
end

function track_monsters_on_destroy(obj)
	db_online_monsters[obj:id()] = nil
end

local function concat_by_func(t, f, sep)
	local s = ""
	sep = sep or ", "
	for k, v in pairs(t) do
		s = s .. f(k, v) .. sep
	end
	return s
end

local function concat_by_name(k, v)
	local obj = level.object_by_id(k)
	if obj then
		return obj:name()
	end
	return [["destroyed"]]
end

local anomaly_amount_per_update = 2
local anomaly_cycle_start_time
local anomaly_restrictor_db_count = 0
function anomaly_restrictor_update()
	local need_invalidate = {}

	if not anomaly_cycle_start_time then
		anomaly_cycle_start_time = time_global()
	end

	-- Couple of anomalies per update, goal is to pass all anomalies in 1 second independent of frame time
	for i = 1, anomaly_amount_per_update do
		anomaly_restrictor_db_k, anomaly_restrictor_db_v = next(anomaly_restrictor_db, anomaly_restrictor_db_k)
		if anomaly_restrictor_db_k and anomaly_restrictor_db_v then
			anomaly_restrictor_db_count = anomaly_restrictor_db_count + 1

			local obj = level.object_by_id(anomaly_restrictor_db_k)
			if obj then
				local prev_entities = dup_table(anomaly_restrictor_db_v.entities)
				empty_table(anomaly_restrictor_db_v.entities)

				local last_pos = anomaly_restrictor_db_v.last_pos
				local new_pos = obj:position()
				local pos_dist_invalidate = last_pos:distance_to_sqr(new_pos) > 16
				if pos_dist_invalidate then
					anomaly_restrictor_db_v.last_pos = new_pos
				end
				

				-- Pure-Lua distance check bypass and optimized monster search loop over db_online_monsters.
				-- Bypasses level.iterate_nearest to avoid Luabind interop and C++ sorting overhead.
				local radius = anomaly_restrictor_db_v.radius
				local cache_cam_pos = device().cam_pos
				local max_dist_limit = 150 + (radius * 2)
				local dist_to_cam_sqr = new_pos:distance_to_sqr(cache_cam_pos)

				if dist_to_cam_sqr < (max_dist_limit * max_dist_limit) then
					local cache_cam_limit_sqr = (150 + radius) * (150 + radius)
					local radius_sqr = radius * radius

					for id, entity in pairs(db_online_monsters) do
						if entity:alive() then
							local pos = entity:position()
							if pos:distance_to_sqr(new_pos) < radius_sqr then
								if pos:distance_to_sqr(cache_cam_pos) < cache_cam_limit_sqr then
									anomaly_restrictor_db_v.entities[id] = true
								end
							end
						end
					end
				end

				local new_entities = anomaly_restrictor_db_v.entities

				if is_empty(new_entities) then
					if is_not_empty(prev_entities) then
						-- print_tip("force_set_restrictor_type(3), obj %s, exited %s", obj:name(), concat_by_func(prev_entities, concat_by_name))
						obj:force_set_restrictor_type(3)
					end
				else
					if is_empty(prev_entities) then
						-- print_tip("force_set_restrictor_type(2), obj %s, entered %s", obj:name(), concat_by_func(new_entities, concat_by_name))
						obj:force_set_restrictor_type(2)
					end
					for k, v in pairs(new_entities) do
						if not prev_entities[k] or pos_dist_invalidate then
							need_invalidate[k] = true
						end
					end
				end
			else
				anomaly_restrictor_db[anomaly_restrictor_db_k] = nil
			end
		else
			-- Recalculate anomaly_amount_per_update to desired goal
			local anomaly_cycle_end_time = time_global()
			local elapsed_ms = anomaly_cycle_end_time - anomaly_cycle_start_time

			if anomaly_restrictor_db_count > 0 and elapsed_ms > 0 then
				if elapsed_ms > 1000 then
					anomaly_amount_per_update = anomaly_amount_per_update + 1
				else
					anomaly_amount_per_update = anomaly_amount_per_update - 1
				end
				anomaly_amount_per_update = clamp(anomaly_amount_per_update, 2, 10)
				-- printf("elapsed_ms %s, count %s, new anomaly_amount_per_update %s", elapsed_ms, anomaly_restrictor_db_count, anomaly_amount_per_update)
			else
				anomaly_amount_per_update = 2
			end

			anomaly_restrictor_db_count = 0
			anomaly_cycle_start_time = nil
			break
		end
	end

	for k, v in pairs(need_invalidate) do
		get_object_by_id(k):invalidate_restrictions()
	end
end

local anomaly_processor_queue = {}
local entity_anomaly_last_gvid = {}
function anomaly_entity_restrictor_update(entity)
	local id = entity:id()
	local gvid = entity:alive() and entity:id() ~= AC_ID and entity:game_vertex_id() or -1
	entity_anomaly_last_gvid[id] = entity_anomaly_last_gvid[id] or -1
	local last_gvid = entity_anomaly_last_gvid[id]
	if gvid == last_gvid then
		return
	end

	if anomaly_restrictor_db_by_gvid[last_gvid] then
		for k, v in pairs(anomaly_restrictor_db_by_gvid[last_gvid]) do
			local obj = level.object_by_id(k)
			if obj then
				local was_not_empty = is_not_empty(v.entities)
				v.entities[id] = nil
				if was_not_empty and is_empty(v.entities) then
					local id = obj:id()
					table.insert(anomaly_processor_queue, function()
						local obj = level.object_by_id(id)
						if obj then
							print_tip("force_set_restrictor_type(3), obj %s", obj:name())
							obj:force_set_restrictor_type(3)
						end
					end)
				end
			else
				anomaly_restrictor_db_by_gvid[last_gvid][k] = nil
			end
		end
	end

	if anomaly_restrictor_db_by_gvid[gvid] then
		for k, v in pairs(anomaly_restrictor_db_by_gvid[gvid]) do
			local obj = level.object_by_id(k)
			if obj then
				table.insert(anomaly_processor_queue, function()
					local entity = level.object_by_id(id)
					if entity then
						entity:invalidate_restrictions()
					end
				end)
				if is_empty(v.entities) then
					local oid = obj:id()
					table.insert(anomaly_processor_queue, function()
						local obj = level.object_by_id(oid)
						if obj then
							print_tip("force_set_restrictor_type(2), obj %s", obj:name())
							obj:force_set_restrictor_type(2)
						end
					end)
				end
				v.entities[id] = true
			else
				anomaly_restrictor_db_by_gvid[gvid][k] = nil
			end
		end
	end

	entity_anomaly_last_gvid[id] = gvid
end

function anomaly_processor_process()
	if #anomaly_processor_queue > 0 then
		local f = table.remove(anomaly_processor_queue)
		f()
	end
end

-- When object is added to alife after game load, remove stale data from tables
function server_object_on_register_remove_stale_data(se_obj)
	local id = se_obj.id
	bind_item.item_uses[id] = nil
	bind_item.item_condition[id] = nil
	item_parts.clear_parts_con(id)
end

