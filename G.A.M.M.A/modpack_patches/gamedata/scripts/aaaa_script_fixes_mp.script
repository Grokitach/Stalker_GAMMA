	end
	return old_axr_generate_available_tasks(npc, is_sim)
end

-- Fix possible busy hands due to storing objects in ui_debug_launcher
function game_object_on_net_destroy_ui_debug_launcher(obj)
	if ui_debug_launcher.o1 and obj:id() == ui_debug_launcher.o1:id() then
		ui_debug_launcher.o1 = nil
	end
	if ui_debug_launcher.o2 and obj:id() == ui_debug_launcher.o2:id() then
		ui_debug_launcher.o2 = nil
	end
end

-- Actually persistent weather
-- Storing last weather file, current weather file and interpolation between them from engine
-- On load first force apply previous weather, then apply new weather but not forced, then apply interpolation
level_weathers_WeatherManager_load_state = level_weathers.WeatherManager.load_state
level_weathers.WeatherManager.load_state = function(self, m_data, ...)
	level_weathers_WeatherManager_load_state(self, m_data, ...)
	if not (m_data.weather_manager) then 
		return
	end

	if level_weathers.bLevelUnderground then
		printf("WeatherManager.load_state is underground, skip")
	else
		self.weather_file_saved = m_data.weather_manager.weather_file
		self.last_weather_file = m_data.weather_manager.last_weather_file
		self.weather_weight = m_data.weather_manager.weather_weight
		self.last_cycle = m_data.weather_manager.last_cycle
		self.cycle_saved = m_data.weather_manager.cycle
		self.next_weather_saved = m_data.weather_manager.next_weather
		self.curr_weather_saved = m_data.weather_manager.curr_weather
		self.preset_saved = m_data.weather_manager.preset
		printf("WeatherManager.load_state loading fields self.weather_file %s, self.last_weather_file %s, self.weather_weight %s, self.cycle %s, self.last_cycle %s, self.next_weather %s, self.curr_weather %s", self.weather_file_saved, self.last_weather_file, self.weather_weight, self.cycle, self.last_cycle, self.next_weather_saved, self.curr_weather_saved)
	end
end

level_weathers_WeatherManager_save_state = level_weathers.WeatherManager.save_state
level_weathers.WeatherManager.save_state = function(self, m_data, ...)
	level_weathers_WeatherManager_save_state(self, m_data, ...)
	if level_weathers.bLevelUnderground then
		printf("WeatherManager.save_state is underground, skip")
	else
		m_data.weather_manager.last_weather_file = self.last_weather_file
		m_data.weather_manager.weather_file = self.weather_file
		m_data.weather_manager.weather_weight = level.get_weather_weight()
		m_data.weather_manager.last_cycle = self.last_cycle
		m_data.weather_manager.next_weather = self.next_weather
		m_data.weather_manager.curr_weather = self.curr_weather	
		printf("WeatherManager.save_state saving fields self.weather_file %s, self.last_weather_file %s, self.weather_weight %s, self.cycle %s, self.last_cycle %s, self.next_weather %s, self.curr_weather %s", self.weather_file, self.last_weather_file, level.get_weather_weight(), self.cycle, self.last_cycle, self.next_weather, self.curr_weather)
	end
end

level_weathers_WeatherManager_select_weather = level_weathers.WeatherManager.select_weather
level_weathers.WeatherManager.select_weather = function(self, now, ...)
	if not self.from_reset then
		self.last_weather_file = self.weather_file
	end
	if self.forced_weather_change_on_time_change then
		self.last_weather_file = nil
	end
	level_weathers_WeatherManager_select_weather(self, now, ...)
end

level_weathers_WeatherManager_get_next_weather_cycle = level_weathers.WeatherManager.get_next_weather_cycle
level_weathers.WeatherManager.get_next_weather_cycle = function(self, curr_weather, ...)
	self.last_cycle = curr_weather
	return level_weathers_WeatherManager_get_next_weather_cycle(self, curr_weather, ...)
end

level_weathers.WeatherManager.weather_file_to_weather = function(self, weather_file)
	if not weather_file then return end

	self.weather_file_to_weather_table = self.weather_file_to_weather_table or {
		clear = "clear",
		partly = "partly",
		cloudy = "cloudy",
		rain = "rain",
		storm = "storm",
		foggy = "foggy",
		tuman = "foggy"
	}
	for k, v in pairs(self.weather_file_to_weather_table) do
		if weather_file:find(k) then
			return v
		end
	end
end

level_weathers_WeatherManager_get_curr_weather = level_weathers.WeatherManager.get_curr_weather
level_weathers.WeatherManager.get_curr_weather = function(self, ...)
	-- This change might affect other scripts, need more testing
	local last_weather = self:weather_file_to_weather(self.last_weather_file)
	local weather = self:weather_file_to_weather(self.weather_file)
	if last_weather and weather then
		local weight = level.get_weather_weight()
		if weight < 0.5 then
			return last_weather
		else
			return weather
		end
	elseif weather then
		return weather
	end
	return level_weathers_WeatherManager_get_curr_weather(self, ...)
end

function level_weathers.WeatherManager:select_custom_weather(now, custom_weather_file, smooth, custom_cycle, custom_next_weather, custom_preset)
	printf("select_custom_weather (%s) | current hour: %s", tostring(now), tostring(level.get_time_hours()) )
	
	-- get type ("atmosfear","indoor","[default]")
	local weather_valid = false
	local weather_cycle
	local wthr = self.weatherType
	if not (wthr) then 
		return
	end
	
	-- if its atmosfear, pick proper event
	if (wthr == "atmosfear") then
		weather_valid = true
		local level_name = level.name()
		
		-- transition weather
		if (self.transition_period == true) then
			wthr = wthr .. "_transition"
			weather_cycle = "cloudy"
			self.transition_period = false
			
		-- pre-surge weather
		elseif (self.pre_blowout_period == true) then
			wthr = wthr .. "_pre_blowout"
			weather_cycle = "pre_blowout"
			self.pre_blowout_period = false
			
		-- normal weather
		else 
			if not (self.cycle) then
				self.cycle = "clear"
			end
			
			weather_cycle = custom_cycle or self.cycle
			wthr = wthr .. "_" .. weather_cycle
		end
	end
	
	self.levelWeather = wthr -- save for transition periods

	-- get proper weather name
	if custom_preset then
		self.preset = custom_preset
	end
	self.last_weather_file = self.weather_file
	self.weather_file = nil
	if weather_valid then
		
		-- pick weather preset
		if self.presets[weather_cycle] then
			if self.preset and self.presets[weather_cycle][self.preset] then
				self.weather_file = self.preset
			else
				self.preset = random_key_table(self.presets[weather_cycle])
				self.weather_file = self.preset
			end
			
		elseif (weather_cycle == "pre_blowout") then
			self.weather_file = random_key_table(self.presets_pre_blowout)
		end

		if custom_preset then
			self.preset = custom_preset
		end
		
		-- pick moon phase, and large maps profiles
		if (weather_cycle == "clear") or (weather_cycle == "partly") then
			--[[
			if big_maps[level.name()] then
				self.weather_file = self.weather_file .. "_large"
			end
			--]]
			
			--self.weather_file = self.weather_file .. "_0" --self:get_moon_phase()
		end
		
		-- set up current and next weather, used for many things like distant storms/Meteorites/DOF
		if now then
			self.curr_weather = custom_next_weather or self.preset
			self.next_weather = self.preset
		else
			self.curr_weather = self.next_weather
			self.next_weather = self.preset
		end
	else
		self.weather_file = wthr
	end
	
	-- hour correction
	if now then
		self.last_hour = level.get_time_hours()
		self.next_hour = self.last_hour + 1
		if (self.next_hour > 23) then
			self.next_hour = self.next_hour - 24
		end
	end
	
	-- reset forced weather call
	if self.forced_weather_change_on_time_change then
		now = true
		self.forced_weather_change_on_time_change = false
	end

	if custom_weather_file then
		self.weather_file = custom_weather_file
	end
		
	-- apply weather change
	if (self.weather_fx) then
		printf("select_custom_weather (%s) | weather_fx: %s", tostring(now), tostring(self.weather_fx))
		level.start_weather_fx_from_time(self.weather_fx, self.wfx_time)
		self.weather_fx = nil 
		self.wfx_time = 0
	else
		if (not self.weather_file) then
			printe("! level_weathers: self.weather_file not generated!")
		elseif (weather.is_paused()) then
			printf("~ level_weathers: weather didn't set because lerping is paused in engine")
		else
			printf("select_custom_weather (%s) | self.weather_file: %s", tostring(now), tostring(self.weather_file))
			if smooth then
				level.set_weather_smooth(self.weather_file)
			else
				level.set_weather(self.weather_file, now)
			end
		end
	end
	
	-- Set brightness
	self:set_brightness_boosts()
	
	printf("select_custom_weather (%s) | cycle: %s - preset: %s - curr_weather: %s - next_weather: %s", tostring(now), weather_cycle, self.preset, self.curr_weather, self.next_weather)
end

level_weathers_WeatherManager_reset = level_weathers.WeatherManager.reset
level_weathers.WeatherManager.reset = function(self, ...)
	self.from_reset = true
	local wfx = self.weather_fx
	level_weathers_WeatherManager_reset(self, ...)
	self.from_reset = false

	local enabled = ui_options.get("video/weather/persistent_weather")
	if enabled and not level_weathers.bLevelUnderground and self.weather_file_saved and self.last_weather_file and self.weather_weight and self.weather_file_saved ~= self.last_weather_file and not (wfx) then
		self:select_custom_weather(true, self.last_weather_file, false, self.last_cycle, self.curr_weather_saved, self.preset_saved)
	    self:select_custom_weather(false, self.weather_file_saved, true, nil, nil, self.preset_saved)
	    level.set_weather_weight(self.weather_weight)
	end
end

-- Perform luagc cleanup
function luagc_cleanup()
	printf("~[luagc_cleanup] collectgarbage before=%sKb",collectgarbage("count")*1024)
	collectgarbage("collect")
	collectgarbage("collect")
	if jit and jit.flush then jit.flush() end
	printf("~[luagc_cleanup] collectgarbage after=%sKb",collectgarbage("count")*1024)
end

-- Bump scheduler batch size on first update for flushing, then reduce it after some time
function actor_on_first_update_scheduler_flush()
	if not level.scheduler_flush then
		return
	end

	level.scheduler_flush(true)
end

function on_loading_screen_dismissed_scheduler_flush_stop()
	if not level.scheduler_flush then
		return
	end

	CreateTimeEvent("reset_scheduler_batch_size", 0, 8, function()
		level.scheduler_flush(false)
		return true
	end)
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update_calculate_rankings)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update_register_callbacks)

	RegisterScriptCallback("actor_on_first_update", actor_on_first_update_scheduler_flush)
	RegisterScriptCallback("on_loading_screen_dismissed", on_loading_screen_dismissed_scheduler_flush_stop)

	-- Prefetch callbacks. Disabled for now, conflict with SSS
	-- RegisterScriptCallback("actor_item_to_slot", actor_item_to_slot_prefetch)
	-- RegisterScriptCallback("actor_on_first_update", actor_on_first_update_prefetch)

	RegisterScriptCallback("npc_on_update", npc_on_update_force_trader_update)
	RegisterScriptCallback("npc_on_hit_callback", transparent_gg_add_to_ignore_ids)

	RegisterScriptCallback("game_object_on_net_destroy", game_object_on_net_destroy_ui_debug_launcher)

	RegisterScriptCallback("ActorMenu_on_item_focus_receive", ActorMenu_on_item_focus_receive)

	-- Reduce anomaly radius for entities, doesn't change pathfinding
	RegisterScriptCallback("anomaly_on_before_activate", anomaly_on_before_activate_pathfinding)
	
	-- Toggle anomaly evading for entities, postpone to loading screen dismissed to ignore initial alife switch 
	do
		RegisterScriptCallback("game_object_on_net_spawn", anomaly_add_to_db)

		RegisterScriptCallback("game_object_on_net_spawn", track_monsters_on_spawn)
		RegisterScriptCallback("game_object_on_net_destroy", track_monsters_on_destroy)

		RegisterScriptCallback("on_loading_screen_dismissed", function()
			-- Per anomaly update via level.iterate_nearest, less stuttery, less reliable which is alright, we don't want perfect evasion
			RegisterScriptCallback("actor_on_update", anomaly_restrictor_update)

			-- Per entity update via gvid change, a lot more stuttery
			-- RegisterScriptCallback("npc_on_update", anomaly_entity_restrictor_update)
			-- RegisterScriptCallback("monster_on_update", anomaly_entity_restrictor_update)
			-- RegisterScriptCallback("actor_on_update", anomaly_processor_process)
		end)		
	end

	-- Force Lua GC and flush LuaJIT trace cache after "first update" calls which will be never executed again
	RegisterScriptCallback("on_loading_screen_key_prompt", luagc_cleanup)

	fix_squad_offline_teleport()
end
