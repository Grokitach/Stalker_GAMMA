	RegisterScriptCallback("server_object_on_register", server_object_on_register_remove_stale_data)
end

-- Fix state_mgr_animation.delayed_attach to not spam events
-- Auto-attach newly created item for special animation
-- requires axr_main function CreateTimeEvent
state_mgr_animation.delayed_attach = function(id)
	if not id then
		return true
	end
	if not alife_object(id) then
		return true
	end

	local itm = level.object_by_id(id)
	if itm then
		itm:enable_attachable_item(true)
		return true
	end
	return false
end

-- Same for ui_debug_main
ui_debug_main.delayed_attach = function(id)
	if not id then
		return true
	end
	if not alife_object(id) then
		return true
	end

	local itm = level.object_by_id(id)
	if itm then
		itm:enable_attachable_item(true)
		ui_debug_main._attached = itm:id()
		return true
	end
	return false
end

-- Fix ui_enemy_health.cs_remove spamming in time events because the wrapper function for time event doesn't return true
ui_enemy_health_cs_remove = ui_enemy_health.cs_remove
ui_enemy_health.cs_remove = function()
	ui_enemy_health_cs_remove()
	RemoveTimeEvent(0, "enemy_health_remove")
	return true
end

-- Attempt for safer DynamicNewsManager
DynamicNewsManagerInit = dynamic_news_manager.DynamicNewsManager.__init
dynamic_news_manager.DynamicNewsManager.__init = function(self)
	DynamicNewsManagerInit(self)
	RegisterScriptCallback("game_object_on_net_destroy", self)

	if self.response and type(self.response) == "table" then
		local who = self.response["who"]
		self.response["who"] = nil
		setmetatable(self.response, {
			__newindex = function(t, key, value)
				if key == "who" then
					if type(value) == "userdata" and type(value.id) == "function" then
						rawset(t, "__responseId", value:id())
						rawset(t, "__responseValue", nil)
					else
						rawset(t, "__responseId", nil)
						rawset(t, "__responseValue", value)
					end
				else
					rawset(t, key, value)
				end
			end,
			__index = function(t, key)
				if key == "who" then
					local responseId = rawget(t, "__responseId")
					local responseValue = rawget(t, "__responseValue")

					if responseId then
						return level.object_by_id(responseId)
					end

					return responseValue
				else
					return rawget(t, key)
				end
			end
		})
		self.response["who"] = who
	end
end

dynamic_news_manager.DynamicNewsManager.CleanObjects = function(self, id)
	if self.loot then
		for i = #self.loot, 1, -1 do
			local item = self.loot[i]
			if type(item) == "userdata" and item:id() == id then
				table.remove(self.loot, i)
			end
		end
	end

	if self.response and self.response["who"] and type(self.response["who"]) == "userdata" and self.response["who"]:id() == id then
		self.response["who"] = nil
	end
end

dynamic_news_manager.DynamicNewsManager.game_object_on_net_destroy = function(self, obj)
	self:CleanObjects(obj:id())
end

-- Fix: prevent level_vertex_id bookmark from warping squad members.
--
-- When a squad member goes offline, net_destroy writes
-- db.offline_objects[id].level_vertex_id from the NPC's last online position.
-- For squad members this causes a bug: system advances se_obj.position during
-- offline travel, but the bookmark stays frozen at the old position. On next
-- online transition, the motivator/bind_monster reads it and warps the NPC
-- back, undoing all offline travel progress.
--
-- Fix: monkey-patch motivator_binder:net_destroy and generic_object_binder:net_destroy
-- to clear the bookmark after the original write.
local function fix_squad_offline_teleport()
	-- Stalker binder (xr_motivator.script)
	local orig_motivator_net_destroy = xr_motivator.motivator_binder.net_destroy
	xr_motivator.motivator_binder.net_destroy = function(self)
		local id = self.object and self.object:id()
		local in_squad = self.squad ~= nil
		orig_motivator_net_destroy(self)
		if in_squad and id and db.offline_objects[id] then
			db.offline_objects[id].level_vertex_id = nil
		end
	end

	-- Monster binder (bind_monster.script)
	local orig_monster_net_destroy = bind_monster.generic_object_binder.net_destroy
	bind_monster.generic_object_binder.net_destroy = function(self)
		local id = self.object and self.object:id()
		local se = id and alife_object(id)
		local in_squad = se and se.group_id and se.group_id ~= 65535
		orig_monster_net_destroy(self)
		if in_squad and id and db.offline_objects[id] then
			db.offline_objects[id].level_vertex_id = nil
		end
	end
end

-- Disable caching in utils_item, with extra setters exported it will have wrong data
utils_item.check_cache = function(...)
	return false
end

-- Disable sim when in Warfare
