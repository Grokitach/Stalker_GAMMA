-- Additional exports from Modded Exes: https://github.com/themrdemonized/xray-monolith
--[[
    
    console commands: {
        snd_doppler_power [0; 5] // Adjust power of doppler effect
        snd_doppler_smoothing [1; 100] // Adjust smoothness of pitch shifting in doppler effect

        crash_save [0; 1] // Enable saving game on game crash
        crash_save_count [0; 20] // Crash saves max number

        pseudogiant_can_damage_objects_on_stomp [0; 1] // Enable the ability for pseudogiants to damage objects on stomp

        pseudogiant_dodge_stomp_while_falling [0; 1] // Prevent pseudogiants stomp attack from damaging actor if they are falling

        allow_accel_during_lookout [0; 1] // flag to allow 'running' speed during left or right lookouts

        scale_hud_motion_marks_by_speed [1; 0] // flag to scale motion marks by speed, default is on

        telekinetic_objects_include_corpses [0; 1] // Enable the ability for poltergeists and burers to throw corpses
        
        sds_enable [0; 1] // Enable shader based scopes
        sds_speed_enable [0; 1] // Enable mouse sensitivity change on zooming
        sds_zoom_enable [0; 1] // Enable correction of max. zoom with scope_factor, if this option is enabled then max. zoom will be such as prescribed in settings regardless of scope_factor value, if this option is disabled then max. zoom will be sum of value prescribed in settings and the increase that gives scope_factor.
        new_zoom_enable [0; 1] // Enable alternative zoom control. Minimal zoom is equal to either mechanical zoom or the one prescribed in section min_scope_zoom_factor. The step of zoom adjustment is more precise. 
        zoom_step_count [1.0, 10.0] // Adjust the step of zoom if new_zoom_enable is on
        new_zoom_delta_algorithm [0; 1] // New zoom delta algorithm

        demo_record_return_ctrl_inputs // Launch (from console or scripts) `demo_record` but propagate ESC and TAB keypresses back to launcher entity (game or scripts) 
        demo_record_blocked_input 1 // Start demo_record without move or stop. The console and Esc key are available
        demo_record_stop // Stop all launched `demo_record` commands 
        demo_set_cam_direction [head, pitch, roll] // Set the direction the camera is facing and its roll. The parameters are in RADIANS, beware
        
        first_person_death // Enable First Person Death Camera
        first_person_death_direction_offset // FPD Camera Direction Offset (in DEGREES)
        first_person_death_position_offset // FPD Camera Position Offset (x, y, z)
        first_person_death_position_smoothing // FPD Camera Position Change Smoothing
        first_person_death_direction_smoothing // FPD Camera Direction Change Smoothing

        use_english_text_for_missing_translations // Enables using english text if translation is missing

        pda_map_zoom_in_to_mouse // Enable map zoom in relative to cursor
        pda_map_zoom_out_to_mouse // Enable map zoom out relative to cursor
        pda_show_map_labels // Show level name labels on the global PDA map if configured in game_maps_single.ltx

        mouse_wheel_change_weapon // Enable changing weapons with mouse wheel
        mouse_wheel_invert_zoom // Invert mouse wheel
        mouse_sens_vertical [0.1; 3] // Vertical mouse sensitivity factor. The number is a multiplicative factor to overall mouse sensitivity, default 1

        string_table_error_msg // Print xml translation errors
        monster_stuck_fix // Enables fix of stuck monsters at the fps cost
        freeze_time [0,1] // Freezes the alife but leaves the sounds playing at the time of the freeze, e.g. soundtrack, looped_fx. No new sounds will be played by the ailife, since it is frozen. You can however, after this point, play new sounds from scripts. 

        allow_outfit_control_inertion_factor 
        allow_weapon_control_inertion_factor // Weapon and outfit control_inertion_factor can affect mouse sens
        render_short_tracers // Tracers will be capped to their minimum length instead of not rendering
        fix_avelocity_spread // Fixes moving the camera around not worsening accuracy
        apply_pdm_to_ads // Enables PDM (handling) values to be applied properly during ADS
        smooth_ads_transition // Smoothly applies the ADS accuracy bonus instead of only being applied when fully ADS
        allow_silencer_hide_tracer // Controls wether or not silencers can hide tracers at all
        use_separate_ubgl_keybind // Use separate keybind for switching to UBGL, or use vanilla system
        aimmode_remember // When switching to UBGL the weapon will remember what mode you switched from and will put you back in that mode
        freelook_while_reloading // // Allows freelook during reload animations
        
        viewport_near [0.0, 1.0] // Adjust the camera near value

        print_bone_warnings // Print warnings when using bone_position and bone_direction functions and encounter invalid bones

        poltergeist_spawn_corpse_on_death // Poltergeists spawn corpses on death
        g_firepos_zoom // Make firepos work while aiming

        g_decouple_horz_recoil // calculate horz recoil independently of vert recoil
        g_use_non_linear_inertia // enable non linear weapon inertia movement

        // Combat AI - fire/suppression logic
        ai_fire_make_sense_interval [0; 20000] // How long (ms) NPCs fire at last known position after losing sight. 0 = fire only while visible. Default 10000
        ai_fire_range_extension [0; 10] // Extra metres past pick_distance where suppression fire still makes sense. Default 2.5
        ai_fire_max_height_diff [0; 8] // Max vertical gap (m) between NPC and enemy for fire to make sense. Default 2.0
        ai_fire_min_dist [0; 20] // Minimum pick_distance (m) required for fire to make sense. Default 2.5

        // Combat AI - cover danger zones
        ai_cover_danger_radius [0; 15] // Danger zone radius (m) when NPC is shot while in cover. Default 3.0
        ai_cover_danger_time [0; 300000] // Duration (ms) of that danger flag. Default 120000
        ai_cover_detour_radius [0; 15] // Danger zone radius (m) when NPC flanks. Default 5.0
        ai_cover_detour_time [0; 300000] // Duration (ms) of that danger flag. Default 120000
        ai_cover_unknown_radius [0; 15] // Danger zone radius (m) on unknown threats. Default 5.0
        ai_cover_unknown_time [0; 300000] // Duration (ms) of that danger flag. Default 120000

        // Combat AI - cover selection distances
        ai_cover_search_near_radius [1; 30] // First-pass cover search radius (m). Default 10.0
        ai_cover_search_far_radius [1; 80] // Fallback cover search radius (m). Default 30.0
        ai_cover_pistol_max_dist [3; 50] // Max cover distance (m) for pistol wielders. Default 10.0
        ai_cover_shotgun_max_dist [3; 20] // Max cover distance (m) for shotgun wielders. Default 5.0
        ai_cover_sniper_min_dist [0; 80] // Min cover distance (m) for sniper wielders. 0 = no minimum. Default 20.0
        ai_cover_default_max_dist [3; 50] // Max cover distance (m) for all other weapons. Default 20.0

        // Combat AI - timing and movement
        ai_close_move_distance [0; 6] // Distance (m) at which TakeCover switches from running to in-place movement. Default 1.5
        ai_crouch_look_out_delta [0; 12000] // LookOut crouch/stand randomization interval (ms). Default 5000
        ai_wait_in_smart_cover_time [0; 120000] // How long (ms) NPC waits at smart cover before giving up. Default 30000

        // Combat AI - danger perception multipliers (1.0 = original, 0.0 = disabled, 5.0 = 5x urgency)
        ai_danger_ricochet_mult [0.0; 5.0] // Bullet ricochet danger urgency multiplier. Default 1.0 (base score 3000)
        ai_danger_attack_sound_mult [0.0; 5.0] // Gunshot sound danger urgency multiplier. Default 1.0 (base score 2500)
        ai_danger_entity_attacked_mult [0.0; 5.0] // Ally hit danger urgency multiplier. Default 1.0 (base score 2000)
        ai_danger_entity_death_mult [0.0; 5.0] // Entity death danger urgency multiplier. Default 1.0 (base score 3000)
        ai_danger_corpse_mult [0.0; 5.0] // Fresh corpse danger urgency multiplier. Default 1.0 (base score 2250)
        ai_danger_attacked_mult [0.0; 5.0] // Being attacked danger urgency multiplier. Default 1.0 (base score 2000)
        ai_danger_grenade_mult [0.0; 5.0] // Grenade danger urgency multiplier. Default 1.0 (base score 1000)
        ai_danger_enemy_sound_mult [0.0; 5.0] // Enemy sound danger urgency multiplier. Default 1.0 (base score 1000)

    }

    lua extensions {
        bit.tobit(int)
        bit.tohex(int)
        bit.bnot(int)
        bit.band(int, int)
        bit.bor(int, int)
        bit.bxor(int, int)
        bit.lshift(int, int)
        bit.rshift(int, int)
        bit.rol(int, int)
        bit.ror(int, int)

        string.trim(s)
        string.trim_l(s)
        string.trim_r(s)
        string.trim_w(s)

        table.keys(t)
        table.values(t)
        table.size(t)
        table.random(t)
    }

    globals {
        string dik_to_keyname(number dik, boolean localize)
        int get_modded_exes_version() // Returns modded exes version in integer format
        table get_string_table() // Returns all translated strings in [string id] = string text format 
        player_hud* get_player_hud()

        // MT only
        string active_tutorial_name()
        class class_info(object) // Returns luabind class with information about object's class: name, methods, attributes
        string r_file_as_string(string path)

        -- color getters / setters
        ClrGetA(number argb)
        ClrGetR(number argb)
        ClrGetG(number argb)
        ClrGetB(number argb)
        ClrSetA(number argb, number a)
        ClrSetR(number argb, number r)
        ClrSetG(number argb, number g)
        ClrSetB(number argb, number b)
    }

    get_console() {
        table get_variable_bounds(cmd)   
    }

    alife() {
        number object_count()
        void iterate_objects(function(se_obj))
        void iterate_level_objects_of_clsid(number script_clsid, function(se_obj)) -- walks actor's current-level CSE registry filtered by m_script_clsid; functor returns true to stop early; must not release the currently iterated entity
        void force_update() -- forces an immediate alife scheduled update cycle
    }

    game {
        Fvector2 world2ui(Fvector pos, bool hud = false, bool allow_offscreen = false)
        Fvector2 world2ui_with_depth(Fvector pos, bool hud = false, bool allow_offscreen = false)
        function ui2world(Fvector2 pos) -> Fvector result, u16 object_id
        function ui2world_offscreen(Fvector2 pos) -> Fvector result, u16 object_id
        change_game_news_show_time(CUIWindow* UIWindow, float show_time)
        update_pda_news_from_uiwindow(CUIWindow* UIWindow)

        bool motion_exists(string model_path, string motion_name) -- Loads a HUD model temporarily and checks whether it contains a named cycle motion. Caller must ensure the file exists first — game crashes on a missing path.
    }

    ini_file() {
        string get_filename()
        void dltx_print(string sec = nil, string line = nil)
        string dltx_get_filename_of_line(string sec, string line)
        table dltx_get_section(string sec)
        bool dltx_is_override(string sec, string line)
    }

    // UI hud
    // get_hud():GetWindow()
    get_hud() {
        CUIWindow GetWindow()
    }

    // Player hud
    // get_player_hud():set_hands("actor_hud_cs_exo")
    get_player_hud() {
        void set_hands(string section)
        void reset_hands()
    }

    namespace ActorMenu {
        CUIMessagesWindow get_messages_menu()
    }

    // MT only
    class cse_alife_item_weapon {
        function clone_upgrades(cse_alife_item_weapon*)
    }

    class cse_alife_level_changer : cse_alife_space_restrictor {
        property dest_game_vertex_id    // u16
        property dest_level_vertex_id   // u32
        property dest_position          // Fvector
    }

    class CUIProgressBar {
        CUIStatic GetProgressStatic()
		bool GetSnapNoDelay() Get the status of "SnapNoDelay"
		void SetSnapNoDelay() Enable: progress visual displays progress position instantly. No longer progressively increase/descrease until meeting the new position.
		void SnapProgressPos() Snap progress visual to current progress position.
    }

    class CUIStatic {
    	void SetColorAnimation(string name, number flags, float delay)
		void ResetColorAnimation()
		void RemoveColorAnimation()
    }

    class CUIDialogWnd : CUIWindow {
        void AllowWorkInPause(bool state)
    }

	 class CUIPdaWnd : CUIDialogWnd {
        // Ncenka - allow to change PDA UI XML file
		function SetPdaXml(string)
		function GetPdaXml()

        // Sync the PDA tab strip with the pda_dynamic_tabs.script registry. Not for mod code:
        // register/unregister call it themselves.
        void RebuildTabs()
    }

    // Dynamic tabs + tab-strip overflow scrolling. For internal use only, use the pda_dynamic_tabs.script registry
    // to manage dynamic tabs
    class CUITabControl : CUIWindow {
        // Insert a tab after the tab `after_id` ("" or unknown = append); size/art/font copy the
        // strip's own tabs. Tab width is fixed, so a too-long caption may clip. False on a control
        // with no tabs. Call RecalcScroll after.
        bool AddTab(string id, string caption, string after_id)
        // Give a tab an icon drawn over its background art, fitted into the slot the strip's XML
        // declares (<icon_layout> on the <tab> node). `art` is a base name: art_e/_d/_h/_t are used
        // when present, a missing state falls back to _e, and a bare `art` alone is tinted with the
        // caption colour instead. False if the tab or the art is unknown. Must be re-applied after
        // AddTab, which builds the tab fresh.
        bool SetTabIcon(string id, string art)
        void RecalcScroll() // recompute strip geometry; scrolling engages only on overflow
    }

    class CUIMessagesWindow : CUIWindow {
        // no extra exports yet
    }

    class CUIPropertiesBox : CUIFrameWindow {
        void AddHeader(string str) // Adds a non-selectable, colored title row (used to group items in a merged context menu)
        CUIPropertiesBox AddSubmenu(string label) // Adds a "label >" row whose submenu expands on hover; returns the child box to populate (AddItem/AddHeader/nested AddSubmenu)
        bool AddItem(string str, u32 id) // Adds a selectable item row carrying a u32 id (read back via GetSelectedItem():GetTAG() / map_spot_menu_property_clicked prop_id); lets a menu carry duplicate labels
    }

    class CUIListBoxItem : CUIFrameLineWnd {
        u32 GetTAG() // Per-item u32 id set via CUIPropertiesBox:AddItem(str, id)
        void SetTAG(u32 value)
    }

    class CUIMainIngameWnd : CUIWindow {
        property m_QuickSlotText1
        property m_QuickSlotText2
        property m_QuickSlotText3
        property m_QuickSlotText4

        table GetQuickSlotIcons()
    }

    // MT only
    class CMapManager {
        void RemoveMapLocationByObjectID(u16 id)
        void RemoveMapLocation(CMapLocation* ml)
        void DisableAllPointers()
    }
    
    // MT only
    class CMapLocation {
        bool HintEnabled()
        string GetHint()
        void SetHint(string hint)
        bool PointerEnabled()
        void EnablePointer()
        void DisablePointer()
        bool Collidable()
        bool SpotEnabled()
        void EnableSpot()
        void DisableSpot()
        string GetLevelName()
        Fvector2 GetPosition()
        u16 ObjectID()
        Fvector3 GetLastPosition()
    }

    class render_device {
        // Switch the pause, with sound emitters and without hint on screen
        void pause_ex(bool state)
    }

    class particles_object {
        void set_hud_mode(bool hud_mode)
    }

    // Debug shapes
    enum DebugRenderType {
        line,
        sphere,
        box,
    }
    debug_render {
        DBG_ScriptObject* add_object(u32 id, DebugRenderType type)
        DBG_ScriptObject* add_object(LPCSTR id, DebugRenderType type)
        void remove_object(u32 id)
        void remove_object(LPCSTR id)
        DBG_ScriptObject* get_object(u32 id)
        DBG_ScriptObject* get_object(LPCSTR id)
        u32 get_flags()
        void set_flags(u32 flags)
        DBG_ScriptSphere* cast_dbg_sphere()
        DBG_ScriptBox* cast_dbg_box()
        DBG_ScriptLine* cast_dbg_line()

        // Common properties
        fcolor color
        bool hud
        bool visible
    }
    class DBG_ScriptSphere {
        Fmatrix matrix
    }
    class DBG_ScriptBox {
        Fmatrix matrix
        Fvector size
    }
    class DBG_ScriptLine {
        Fvector point_a
        Fvector point_b
    }
    // examples
        local sphere = debug_render.add_object(1337, DBG_ScriptObject.sphere):cast_dbg_sphere()
        sphere.visible = true
        sphere.color = fcolor():set(1,0,0,1)
        local scale_mat = matrix():identity():scale(0.1,0.1,0.1)
        local pos_mat = matrix():translate(db.actor:position())
        local mat = matrix():mul(pos_mat, scale_mat)
        sphere.matrix = mat

        local line = debug_render.add_object(9, DBG_ScriptObject.line):cast_dbg_line()
        line.point_a = db.actor:position()
        line.point_b = vector():set(0, 0, 0)
        
        local box = debug_render.add_object(12, DBG_ScriptObject.box):cast_dbg_box()
        box.size = vector():set(0.5,1,0.5)


    // Query data from actor ray queries
    // Actor = Pick active ray from Weapon / Device / Camera
	enum ETraceTarget {
		Camera      = 0,
		Weapon      = 1,
		Device      = 2,
		Actor       = 3,
	}

    // Encodings used for dds formats, DX10/11 Compatible
	enum DxEncoding {
		eDXE_A8R8G8B8 = 0,
		eDXE_DXT1 = 1,
		eDXE_DXT5 = 2,
		eDXE_BC7 = 3,
		eDXE_undefined = 4,
    }
    level {
        float get_music_volume()
        void set_music_volume(float)

        float get_weather_weight()
        void set_weather_weight(float)
        void set_weather_smooth(string)

        // Camera, position is x,y,z vector, direction is head,pitch,roll vector in RADIANS
        void set_cam_custom_position_direction(Fvector position, Fvector direction, int smoothing, bool hudDraw, bool hudAffect)
        void set_cam_custom_position_direction(Fvector position, Fvector direction, int smoothing, bool hudDraw)
        void set_cam_custom_position_direction(Fvector position, Fvector direction, int smoothing)
        void set_cam_custom_position_direction(Fvector position, Fvector direction)
        void remove_cam_custom_position_direction()

        // Removes all engine-spawned per-animation HUD camera effectors
        // Scripted effectors added via add_cam_effector are not touched.
        void remove_hud_motion_cam_effectors()

        game_object get_target_obj(ETraceTarget)
        game_object get_target_obj()
        number get_target_dist(ETraceTarget)
        number get_target_dist()
        number get_target_element(ETraceTarget)
        number get_target_element()
        Fvector get_target_pos(ETraceTarget)
        Fvector get_target_pos()
        script_rq_result get_target_result(ETraceTarget)
        script_rq_result get_target_result()

        table get_nearby_vertices(pos, radius) // can be used to collect nearby vertices. ([lvid] = true)
        number vertex_link(lvid, index) // can be used to get the vertices that is connected to the current vertex.
        table get_nearby_covers(pos, radius) // can be used to collect nearby vertices that are covers. ([lvid] = true)

        // antglobes
        Fvector get_sun_pos() // Get the sun's position in the sky
        Fcolor get_sun_color() // Get the float represenation of the sun's color in rgb format
        float get_sun_intensity() // Get the sun's brightness
        bool is_sun_visible() // Check if the weather is clear

        //Take Screenshot (written to textures folder), each 'dimensions' field must be to power of 2
        void take_screenshot(LPCSTR path, Fvector2 dimensions, DxEncoding dx_encoding)

        void map_remove_all_object_spots(id)

        CUIStatic* map_get_object_spot_static(u16 id, LPCSTR spot_type)
        CUIStatic* map_get_object_minimap_spot_static(u16 id, LPCSTR spot_type)
        table map_get_object_spots_by_id(u16 id) // Returns array of tables
        // {
            spot_type: string, icon ID from map_spots XML
            text: string, text when spot is hovered
        // }

        void map_pan_to(LPCSTR level_name, float x, float z, bool zoom_in)
        void map_pan_to_level(LPCSTR level_name, bool zoom_in)

        // MT only
        CMapManager* get_map_manager()
        void patrol_path_add(string patrol_path, CPatrolPath* path)
        void patrol_path_remove(string patrol_path)

        add_bullet(Fvector pos, Fvector dir, float speed, float power, float impulse, u16 sender, ALife::EHitType hit_type, float max_dist, LPCSTR ammo_sect, float air_resistance)

        add_bullet(table t)
        // Supported parameters and example:
        //    local t = {
        //        pos = device().cam_pos,
        //        dir = device().cam_dir,
        //        speed = 10,
        //        power = 1,
        //        impulse = 1,
        //        sender = AC_ID,
        //        senderweapon = db.actor:active_item():id(),   // Defaults to what's set for sender if not specified
        //        hit_type = 1,
        //        max_dist = 100,
        //        ammo_sect = "ammo_5.56x45_fmj",
        //        air_resistance = 0.2,
        //    }
        //    level.add_bullet(t)

         // Script Attachments
        function add_attachment(string, string)
        function get_attachment(string)
        function remove_attachment(string)
        function remove_attachment(script_attachment)
        function iterate_attachments(function)

        // MT only
        function scheduler_flush(bool)
    }

    // obj:get_physics_shell()
    class PHShell {
        void apply_torque(float roll, float yaw, float pitch)
		void set_linear_vel(vector)
		void set_angular_vel(vector)
        void set_force_exact_integration() // step this object's physics island with the exact solver
                                           // (dWorldStep) bypassing the 30-joint budget that gates the
                                           // vehicles' default preference (capped at 96 island joints).
                                           // Needed by >4-wheel vehicles: wheel+contact joints exceed
                                           // 30, silently demoting them to quickstep, which cannot
                                           // transmit wheel motor torque into a heavy hull.
    }

    // obj:get_car()
    class CCar {
        function GetSpeed() -> float // signed forward m/s, negative = reversing
        function SetTargetSpeed(float mps) // speed governor, negative = reverse
        function ClearTargetSpeed()
        function SetThrottle(float k) // 0..1 drive torque scale
        function SetSteer(float k) // -1..1, + = right
        function GetWheelFriction() -> float // wheel-ground friction multiplier (mu_factor)
        function SetWheelFriction(float k)
        function Transmission(number gear) // 0 = reverse, 1..N = forward gears
        function TransmissionUp()
        function TransmissionDown()
        function CurrentTransmission() -> number
        function RefWheelMaxSpeed() -> float
        function EnginePower() -> float
        function EngineCurTorque() -> float
        function DoorOpen(number bone_id) / DoorClose / DoorUse / DoorSwitch
        function IsDoor(number bone_id) -> bool
		
		function SetUseAction(string)
		function GetZoomFactor() -> float
		function GetViewportNear() float
		function SetViewportNear(float)
		
		/* Camera scope with different zooming levels. */
		function IsScopeEnable() -> bool
		function GetScopeSize() number
		function GetScopeActive() number
		function SetScopeActive(number)
		
		/* Drone subclass */
		function CCarDrone_GetPowerEfficiency() -> float
		function CCarDrone_SetPowerEfficiency(float)
		
		/* Visual 3D camera on model */
		function VisualCamera_GetDesireAngle() -> float
		function VisualCamera_GetRotXCur() -> float
		function VisualCamera_GetRotYCur() -> float
		
        callbacks (see callbacks_gameobject.script): car_on_hit, car_on_weapon_fired
    }

    class Fvector {
        static functions:
            vector.generate_orthonormal_basis(Fvector dir, Fvector up, Fvector right)
            vector.generate_orthonormal_basis_normalized(Fvector dir, Fvector up, Fvector right)

        function add(float x, float y, float z)
        function sub(float x, float y, float z)
        function mul(float x, float y, float z)
        function div(float x, float y, float z)
        function distance_to_xz_sqr(Fvector)
        function project(Fvector u, Fvector v)
        function project(Fvector v)

        function hud_to_world()
        function world_to_hud()

        function hud_to_world_dir()
        function world_to_hud_dir()
    }

    class Fvector2 {
        function normalize()
    }

    class Fmatrix {
        property i
        property _14_
        property j
        property _24_
        property k
        property _34_
        property c
        property _44_

        matrix()

        function set(Fmatrix)
        function set(Fvector, Fvector, Fvector, Fvector) 
        function identity()
        function mk_xform(quaternion, Fvector)
        function build_camera_dir(Fvector vFrom, Fvector vView, Fvector vWorldUp)
        function build_projection(float fov, float aspect, float nearPlane, float farPlane)
        function mulA_43(Fmatrix A)
        function mulA_44(Fmatrix A)
        function mulB_43(Fmatrix B)
        function mulB_44(Fmatrix B)
        function mul_43(Fmatrix A, Fmatrix B)
        function translate(float x, float y, float z)
        function translate(Fvector)
        function translate_add(float x, float y, float z)
        function translate_add(Fvector)
        function translate_over(float x, float y, float z)
        function translate_over(Fvector)
        function mul(Fmatrix, Fmatrix)
        function mul(Fmatrix, float)
        function mul(float)
        function invert()
        function invert(Fmatrix)
        function invert_b(Fmatrix)
        function div(Fmatrix, float)
        function div(float)
        function scale(float x, float y, float z)
        function scale(Fvector)
        function setHPB(float x, float y, float z)
        function setHPB(Fvector)
        function setXYZ(float x, float y, float z)
        function setXYZ(Fvector)
        function setXYZi(float x, float y, float z)
        function setXYZi(Fvector)
        Fvector getHPB()
        function transform(Fvector, Fvector)
